[Default Applications]
x-scheme-handler/http=com.google.Chrome.desktop
x-scheme-handler/https=com.google.Chrome.desktop
text/html=com.google.Chrome.desktop

# Ordner bleiben bei PCManFM, damit "Ordner oeffnen" aus den Browser-
# Downloads weiter funktioniert. Yazi steht darunter als Alternative.
inode/directory=pcmanfm.desktop

# Text, Markdown und Code gehen zum Bearbeiten in Helix.
text/markdown=helix-alacritty.desktop
text/x-markdown=helix-alacritty.desktop
text/plain=helix-alacritty.desktop
application/x-shellscript=helix-alacritty.desktop
text/x-shellscript=helix-alacritty.desktop
text/x-python=helix-alacritty.desktop
application/json=helix-alacritty.desktop
application/toml=helix-alacritty.desktop
text/x-toml=helix-alacritty.desktop
application/x-yaml=helix-alacritty.desktop
text/x-yaml=helix-alacritty.desktop
text/x-csrc=helix-alacritty.desktop
text/x-chdr=helix-alacritty.desktop
text/x-c++src=helix-alacritty.desktop
text/x-c++hdr=helix-alacritty.desktop
text/rust=helix-alacritty.desktop
text/x-lua=helix-alacritty.desktop
text/javascript=helix-alacritty.desktop
application/javascript=helix-alacritty.desktop
text/css=helix-alacritty.desktop
text/x-makefile=helix-alacritty.desktop
text/x-log=helix-alacritty.desktop
text/x-diff=helix-alacritty.desktop
text/x-patch=helix-alacritty.desktop

# Bilder im richtigen Bildbetrachter statt als ASCII im Terminal.
image/jpeg=nsxiv.desktop
image/png=nsxiv.desktop
image/gif=nsxiv.desktop
image/webp=nsxiv.desktop
image/bmp=nsxiv.desktop
image/tiff=nsxiv.desktop
image/avif=nsxiv.desktop

[Added Associations]
# Diese tauchen im Rechtsklick unter "Oeffnen mit" auf, ohne Standard zu sein.
text/markdown=glow-alacritty.desktop;bat-alacritty.desktop;com.google.Chrome.desktop;
text/x-markdown=glow-alacritty.desktop;bat-alacritty.desktop;
text/plain=bat-alacritty.desktop;com.google.Chrome.desktop;
inode/directory=yazi-alacritty.desktop;
