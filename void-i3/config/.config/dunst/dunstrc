# dunst -- Benachrichtigungen und OSD-Balken
#
# Void liefert keine Vorlage mit (/etc/xdg/dunst/ existiert nicht), diese
# Datei ist also vollstaendig selbst geschrieben. Was hier nicht steht,
# bleibt auf dunsts eingebautem Standard.
#
# Design wie der Rest: monochromes Grau, eckig, keine Rundungen. Farbe ist
# reine Signalfunktion -- nur die Dringlichkeitsstufe "critical" faerbt den
# Rahmen rot (Gruvbox #fb4934, dasselbe Rot wie in i3status und i3).
#
# Zwei Nutzungsarten teilen sich diese Konfiguration:
#   1. echte Benachrichtigungen (Firefox, Akkuwache) -- bleiben stehen
#   2. OSD-Balken fuer Lautstaerke und Helligkeit -- verschwinden schnell
# Getrennt werden sie ueber die Dringlichkeit: "low" ist das OSD.

[global]
    monitor = 0
    follow = none

    # Oben rechts, knapp unter der 30px hohen i3-Leiste.
    origin = top-right
    offset = (12, 42)
    width = (240, 420)
    height = (0, 180)
    notification_limit = 4

    # Abstand zwischen mehreren Meldungen
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    corner_radius = 0

    # Fortschrittsbalken -- das ist der eigentliche OSD-Teil. dunst zeichnet
    # ihn, sobald eine Meldung den Hinweis "int:value:N" mitbringt.
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 210
    progress_bar_max_width = 390
    progress_bar_corner_radius = 0

    # Schrift wie in i3bar und rofi. Die Familienliste zuerst, Groesse am
    # Ende -- so greift sie fuer beide Familien.
    font = Red Hat Mono, Symbols Nerd Font Mono 11
    line_height = 0
    markup = full
    format = "<b>%s</b>%n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    # Symbole aus Programmen (z. B. Firefox) anzeigen, aber klein halten.
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark, Adwaita, hicolor"
    icon_position = left
    min_icon_size = 0
    max_icon_size = 32

    # Mausbedienung: links wegklicken, rechts alle schliessen,
    # mittig die hinterlegte Aktion oeffnen (z. B. Firefox-Meldung anklicken).
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # Meldungen ueberleben den Sperrbildschirm nicht sichtbar
    ignore_dbusclose = false
    sort = urgency_descending
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = false

[urgency_low]
    # Diese Stufe nutzen die OSD-Balken: kurz sichtbar, kein roter Rahmen.
    background = "#1e1e1e"
    foreground = "#e8e8e8"
    frame_color = "#3a3a3a"
    timeout = 2

[urgency_normal]
    # Gewoehnliche Benachrichtigungen, etwa von Firefox.
    background = "#1e1e1e"
    foreground = "#e8e8e8"
    frame_color = "#3a3a3a"
    timeout = 8

[urgency_critical]
    # Akku fast leer, CPU zu heiss. Bleibt stehen, bis man sie wegklickt --
    # timeout 0 ist Absicht.
    background = "#1e1e1e"
    foreground = "#e8e8e8"
    frame_color = "#fb4934"
    timeout = 0
