#!/bin/sh
# Default rc.local for void; add your custom commands here.
#
# This is run by runit in stage 2 before the services are executed
# (see /etc/runit/2).

# WLAN-Softblock aufheben (hp_wmi blockt beim Boot).
#
# Die Zeile allein reicht nicht: sie laeuft in Sekunde ~6, hp_wmi laedt in
# Sekunde 5,8 und meldet danach noch eigene Ereignisse. Ein Block, der erst
# spaeter kommt, bleibt dann stehen -- WLAN war nach jedem Neustart aus.
# Darum haelt /etc/funk-beim-boot.sh im Hintergrund noch anderthalb Minuten
# lang dagegen (und schreibt mit, was passiert ist:
# /var/log/funk-beim-boot.log). Diese Zeile bleibt als sofortiger erster
# Griff stehen, sie kostet nichts.
rfkill unblock wifi
/etc/funk-beim-boot.sh >/dev/null 2>&1 &

# /run liegt auf tmpfs, /run/user ist nach dem Boot also weg.
# pam_dumb_runtime_dir (steht als Void-Standard in /etc/pam.d/system-login)
# legt darin beim Login /run/user/<uid> an und setzt XDG_RUNTIME_DIR -- das
# Elternverzeichnis erzeugt es aber nicht selbst. Ohne diese zwei Zeilen
# findet PipeWire kein Laufzeitverzeichnis und startet gar nicht erst.
mkdir -p /run/user
chmod 755 /run/user
