#!/usr/bin/python3
# i3status-melder  -- i3status mit einer Glocke ganz rechts in der Leiste
#
# i3bar ruft nicht mehr i3status direkt auf, sondern dieses Skript (siehe
# "status_command" in ~/.config/i3/config). Es reicht alles von i3status
# unveraendert durch und haengt rechts einen weiteren Block an:
#
#   Linksklick  -> ~/.local/bin/benachrichtigungen (Verlauf per rofi)
#   Rechtsklick -> Verlauf sofort leeren
#
# Ausserdem macht es zwei Bloecke von i3status anklickbar. i3status vergibt
# jedem Block einen Namen, an dem sich die Klicks auseinanderhalten lassen
# ("wireless", "volume"). Auf die instance ist kein Verlass: dort steht der
# aufgeloeste Wert, also "wlo1" statt "_first_".
#
#   Ton     Linksklick -> stumm um, Mausrad -> lauter/leiser.
#           Beides ueber ~/.local/bin/osd, nicht ueber pactl direkt: nur so
#           laufen die LED in F5 und der OSD-Balken mit wie bei den Tasten.
#   WLAN    Linksklick -> Funk an/aus per rfkill.
#
# Ausserdem fasst es die vier Systemwerte von i3status (CPU, Temperatur, RAM,
# Platte) zu EINEM Block ganz links zusammen: in der Leiste steht dann nur noch
# das CPU-Icon mit dem Prozentwert, ein Linksklick wechselt auf die Vitals-
# Flaeche, wo das Dashboard alles ausfuehrlich zeigt. Reisst einer der vier
# Werte seine Warnschwelle, tritt er in der Leiste wieder hervor -- erkannt
# wird das am Rot, das i3status ueber format_above_threshold selbst setzt.
#
# Und es haengt links neben dem WLAN einen Bluetooth-Block ein -- i3status
# kennt Bluetooth nicht, der Block stammt also ganz aus diesem Skript:
#
#   Linksklick  -> Funk an/aus, Rechtsklick -> Menue (Geraete verbinden).
#   Beides ueber ~/.local/bin/bluetooth, das auch im Terminal bedienbar ist.
#
# Rechts neben dem WLAN steht der Tailscale-Block -- Funk, lokales Netz, Netz
# darueber. Er beantwortet die einzige Frage, die im Alltag zaehlt: komme ich
# an die Gegenstelle ran. Gruen heisst direkt verbunden, Gelb ueber einen
# Relay-Server (langsamer), Grau erreichbar-aber-weg, Rot "Anmeldung noetig"
# -- der Fall, der sonst monatelang unbemerkt bleibt, bis nichts mehr geht.
#
#   Linksklick -> Tailnet an/aus.
#   Braucht keinen sudo, weil der Benutzer bei tailscaled als Operator
#   eingetragen ist. Welcher Rechner beobachtet wird, steht in
#   ~/.config/i3status-melder/tailscale-peer (siehe TS_PEER_DATEI).
#
# WARUM ein Wrapper: i3status kann selbst keine Mausklicks entgegennehmen.
# Klickbare Bloecke gibt es nur ueber das i3bar-Protokoll, und dafuer muss
# im Kopf "click_events": true stehen -- das setzt hier dieses Skript, und
# es liest die Klick-Ereignisse, die i3bar daraufhin auf stdin schickt.
#
# Die Zahl neben der Glocke ist die Laenge des dunst-Verlaufs. Sie kommt
# nicht aus einer Abfrage im Sekundentakt, sondern aus "gdbus monitor":
# dunst meldet historyLength als geaenderte D-Bus-Eigenschaft, die Leiste
# aktualisiert sich also im selben Moment, in dem eine Meldung kommt.
# Klappt der Monitor nicht, wird bei jeder i3status-Zeile nachgefragt.

import html
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time

DIENST = "org.freedesktop.Notifications"
OBJEKT = "/org/freedesktop/Notifications"
SCHNITT = "org.dunstproject.cmd0"

VERLAUF = os.path.expanduser("~/.local/bin/benachrichtigungen")
OSD = os.path.expanduser("~/.local/bin/osd")
# Arbeitsflaeche und Fensterklasse des Vitals-Dashboards (siehe "assign" und
# den Autostart in ~/.config/i3/config).
VITALS_FLAECHE = "4"
VITALS_KLASSE = "vitals-dashboard"
VITALS_START = os.path.expanduser("~/.local/bin/vitals")

# Die vier i3status-Module, die zu einem Block werden. Die Namen vergibt
# i3status; der Block von 'disk "/"' heisst dort "disk_info", nicht "disk".
SYSTEM_MODULE = ("cpu_usage", "cpu_temperature", "memory", "disk_info")

# Die Warnfarbe aus ~/.config/i3status/config. An ihr -- und nicht an einer
# zweiten Schwellenrechnung hier -- wird erkannt, ob ein Modul anschlaegt:
# die Schwellen stehen so weiter nur an einer Stelle.
WARNROT = "#fb4934"

GLOCKE = "\U000f009a"       # nf-md-bell        -- Verlauf hat Eintraege
GLOCKE_AUS = "\U000f009b"   # nf-md-bell_off    -- Verlauf ist leer

# Farben wie in ~/.config/i3status/config: Grau ist der Normalfall,
# Gelb bedeutet "da liegt etwas".
GRAU = "#9a9a9a"
STUMPF = "#555555"
GELB = "#fabd2f"

# Icon und Farbe wie format_down in ~/.config/i3status/config, nur mit
# anderem Text -- warum, steht bei wlan_block_ersetzen().
WLAN_AUS = "\U000f05aa"     # nf-md-wifi_off
WLAN_AUS_TEXT = "  <span foreground='{0}'>{1}</span> <span foreground='{0}'>WLAN aus</span>  ".format(
    STUMPF, WLAN_AUS)

RFKILL = "/sys/class/rfkill"

BLAU = "#83a598"

# Bluetooth-Block: Icons und Zustaende. Farbe wie ueberall reine Signalfunktion --
# blau heisst "Funk laeuft", stumpfes Grau heisst "aus".
BT = "\U000f00af"        # nf-md-bluetooth         -- an, nichts verbunden
BT_AUS = "\U000f00b2"    # nf-md-bluetooth_off     -- Funk aus
BT_VERB = "\U000f00b1"   # nf-md-bluetooth_connect -- Geraet verbunden
# Heisst in der Schrift bluetooth_settings, zeigt aber das Bluetooth-Zeichen
# mit drei Punkten darunter -- gelesen wird es hier als "Bluetooth arbeitet".
# bluetooth_transfer (die Fassung mit den Pfeilen) meint Datenuebertragung.
BT_SUCHE = "\U000f00b3"

# Takt der Suchanzeige. Die wandernden Punkte sind kein Zierrat: die Suche
# dauert acht Sekunden und sieht sonst genauso aus wie eingeschaltetes
# Bluetooth -- an der Bewegung ist sie ohne Nachdenken zu erkennen.
PULS = 0.6

BLUETOOTH = os.path.expanduser("~/.local/bin/bluetooth")

# Zustand des Adapters, gefuellt von bt_abfragen(): None heisst "noch nichts
# gelesen", ein leeres dict heisst "kein Adapter da" -- dann faellt der Block weg.
bt = None
bt_gelesen = 0.0
bt_punkte = 0
bt_puls_laeuft = False
bt_uhr = None

# Tailscale-Block: haengt der Rechner im Tailnet, und ist die Gegenstelle da.
GRUEN = "#8ec07c"
ROT = "#fb4934"          # wie urgent_workspace in ~/.config/i3/config

TS_AN = "\U000f048d"     # nf-md-server_network     -- Tailnet laeuft
TS_AUS = "\U000f048e"    # nf-md-server_network_off -- aus, oder Gegenstelle weg
TS_LOGIN = "\U000f099d"  # nf-md-shield_lock        -- Anmeldung noetig

# Anders als Glocke und Bluetooth haengt dieser Block an keinem Monitor: der
# Zustand aendert sich alle paar Stunden, nicht mehrmals pro Minute. Ein
# Push-Kanal (tailscaled kann das ueber /localapi/v0/watch-ipn-bus) waere hier
# Aufwand ohne Gegenwert. Stattdessen jede TS_TAKT-te i3status-Zeile eine
# Abfrage, bei 5 s Takt also rund alle 30 Sekunden.
TS_TAKT = 6

# Welche Gegenstelle beobachtet wird -- eine Zeile mit dem Rechnernamen.
# Bewusst eine Datei und keine Konstante: im Repo stehen keine echten
# Rechnernamen. Fehlt die Datei, sucht sich der Block den Peer selbst.
TS_PEER_DATEI = os.path.expanduser("~/.config/i3status-melder/tailscale-peer")

# Telefone zaehlen bei der Selbstsuche nicht: erreichbar sein *will* man
# Rechner und Server, ein Handy im Tailnet ist kein Zustand, der die Leiste
# rot faerben sollte.
TS_MOBIL = ("android", "iOS", "ios")

# None heisst "kein tailscale auf dem Rechner" -- dann faellt der Block weg,
# genau wie der Bluetooth-Block ohne Adapter.
ts = None
ts_zaehler = 0

anzahl = 0
letzte_zeile = []
schloss = threading.Lock()
monitor_laeuft = False
bt_monitor_laeuft = False


def verlauf_laenge():
    """Laenge des dunst-Verlaufs ueber die D-Bus-Eigenschaft historyLength."""
    try:
        fertig = subprocess.run(
            ["gdbus", "call", "--session", "--dest", DIENST,
             "--object-path", OBJEKT, "--method",
             "org.freedesktop.DBus.Properties.Get", SCHNITT, "historyLength"],
            capture_output=True, text=True, timeout=3)
        treffer = re.search(r"uint32 (\d+)", fertig.stdout)
        return int(treffer.group(1)) if treffer else 0
    except (OSError, subprocess.SubprocessError):
        return 0


def wlan_geblockt():
    """True, wenn der WLAN-Funk per rfkill abgeschaltet ist.

    Gelesen wird aus /sys statt ueber "rfkill list": das ist ein reiner
    Dateizugriff ohne eigenen Prozess und laeuft bei jedem Neuzeichnen mit.
    Ein Hard-Block (Schalter am Geraet) zaehlt als "aus" mit -- fuer die
    Anzeige ist er dasselbe, nur aufheben laesst er sich per Software nicht.
    """
    try:
        for eintrag in os.listdir(RFKILL):
            ordner = os.path.join(RFKILL, eintrag)
            with open(ordner + "/type", encoding="ascii") as d:
                if d.read().strip() != "wlan":
                    continue
            for was in ("soft", "hard"):
                with open(ordner + "/" + was, encoding="ascii") as d:
                    if d.read().strip() == "1":
                        return True
    except OSError:
        pass
    return False


def wlan_block_ersetzen(bloecke):
    """i3status kennt nur "verbunden" und "nicht verbunden" -- abgeschaltetes
    WLAN sieht dort aus wie ein Funkloch. Seit der Block anklickbar ist, muss
    der Unterschied sichtbar sein: sonst weiss man nach einem Klick nicht, ob
    man den Funk ausgeschaltet hat oder nur gerade keine Verbindung da ist.

    Der Block wird kopiert, nicht geaendert: letzte_zeile haelt dieselben
    Objekte fuer das Neuzeichnen fest.
    """
    if not wlan_geblockt():
        return bloecke
    return [dict(b, full_text=WLAN_AUS_TEXT) if b.get("name") == "wireless" else b
            for b in bloecke]


def i3status_wecken():
    """i3status sofort eine neue Zeile schreiben lassen, statt bis zum
    naechsten Takt (5 s) zu warten -- dasselbe Signal, das auch ~/.local/bin/osd
    am Ende schickt."""
    try:
        subprocess.run(["pkill", "-SIGUSR1", "-x", "i3status"],
                       capture_output=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass


def nachziehen():
    """Nach dem Einschalten braucht wpa_supplicant ein paar Sekunden bis zur
    Verbindung (gemessen rund drei). Ohne Nachtreten stuende die Leiste
    solange auf "kein WLAN", obwohl der Funk laengst wieder laeuft."""
    for _ in range(6):
        time.sleep(2)
        i3status_wecken()


def wlan_umschalten():
    """Funk an- oder ausschalten.

    Ohne sudo moeglich, weil /dev/rfkill per udev-Regel der Gruppe wheel
    gehoert (/etc/udev/rules.d/60-rfkill-unblock.rules). In derselben Datei
    steht auch, warum dort ACTION=="add" stehen muss: ohne den Filter hebt
    udev jeden Block im selben Moment wieder auf.
    """
    aus = wlan_geblockt()
    try:
        subprocess.run(["rfkill", "unblock" if aus else "block", "wlan"],
                       capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return
    neu_zeichnen()          # der ersetzte Block stimmt sofort
    i3status_wecken()
    if aus:
        threading.Thread(target=nachziehen, daemon=True).start()


def bt_abfragen():
    """Adapterzustand von ~/.local/bin/bluetooth holen.

    Die Abfrage laeuft ueber dasselbe Skript, das auch die Klicks ausfuehrt --
    so steht die Logik (bluetoothctl, rfkill, Namen der Geraete) an einer
    Stelle statt zweimal leicht verschieden. Kostet einen Prozess, faellt aber
    kaum ins Gewicht: aufgerufen wird sie nicht im Takt, sondern nur wenn
    bluez eine Aenderung meldet (siehe bt_monitor).
    """
    global bt, bt_gelesen, bt_puls_laeuft
    bt_gelesen = time.monotonic()
    try:
        fertig = subprocess.run([BLUETOOTH, "zustand"],
                                capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        bt = {}                     # bluetoothd haengt oder ist weg
        return
    zeilen = fertig.stdout.splitlines()
    if not zeilen or zeilen[0].startswith("kein"):
        bt = {}
        return
    bt = {
        "an": zeilen[0].strip() == "an",
        "sucht": "sucht" in [z.strip() for z in zeilen[1:]],
        "geraete": [z.split("  ", 1)[1].strip()
                    for z in zeilen[1:] if z.startswith("verbunden: ")],
    }
    if bt["sucht"] and not bt_puls_laeuft:
        bt_puls_laeuft = True       # vor dem Start gesetzt, sonst laufen zwei
        threading.Thread(target=bt_suchanzeige, daemon=True).start()


def bt_suchanzeige():
    """Waehrend der Suche die Punkte weiterwandern lassen.

    Laeuft nur, solange wirklich gesucht wird, und fragt dabei ab und zu selbst
    nach: das Ende der Suche meldet bluez zwar, aber wenn diese eine Meldung
    verloren ginge, liefe die Anzeige sonst endlos weiter.
    """
    global bt_punkte, bt_puls_laeuft
    runde = 0
    while bt and bt.get("sucht"):
        time.sleep(PULS)
        bt_punkte = (bt_punkte + 1) % 4
        runde += 1
        if runde % 4 == 0:
            bt_abfragen()
        neu_zeichnen()
    bt_punkte = 0
    bt_puls_laeuft = False
    neu_zeichnen()                  # letzter Stand ohne Punkte


def bt_uhr_stellen():
    """Eine gedrosselte Meldung in einer Sekunde nachholen.

    Ohne das koennte der Beginn einer Suche untergehen: er ist eine einzelne
    Meldung, und faellt sie in die Drosselung von bt_monitor, kaeme die
    naechste erst mit dem ersten gefundenen Geraet -- in einer leeren Umgebung
    also nie.
    """
    global bt_uhr
    if bt_uhr is not None and bt_uhr.is_alive():
        return
    bt_uhr = threading.Timer(1.0, lambda: (bt_abfragen(), neu_zeichnen()))
    bt_uhr.daemon = True
    bt_uhr.start()


def bt_block():
    """Der Bluetooth-Block, oder None solange kein Adapter bekannt ist."""
    if not bt:
        return None
    if not bt["an"]:
        text = "  <span foreground='{0}'>{1}</span> <span foreground='{0}'>aus</span>  ".format(
            STUMPF, BT_AUS)
        return {"name": "bluetooth", "full_text": text, "markup": "pango"}

    if bt.get("sucht"):
        # Gelb ist in dieser Leiste die Farbe fuer "hier passiert gerade
        # etwas" (siehe Glocke und Akku). Die Punkte stehen auf fester Breite,
        # damit die Nachbarbloecke im Takt nicht hin und her rutschen.
        text = "  <span foreground='{0}'>{1}</span> <span foreground='{0}'>sucht{2}</span>  ".format(
            GELB, BT_SUCHE, ("." * bt_punkte).ljust(3))
        return {"name": "bluetooth", "full_text": text, "markup": "pango"}

    geraete = bt["geraete"]
    if not geraete:
        icon, wort = BT, "an"
    elif len(geraete) == 1:
        # Gekuerzt, damit ein langer Geraetename die Leiste nicht verschiebt;
        # escape(), weil der Name als Pango-Markup gelesen wird und ein "&"
        # im Namen sonst die ganze Zeile ungueltig machen wuerde.
        icon, wort = BT_VERB, html.escape(geraete[0][:16])
    else:
        icon, wort = BT_VERB, "{} Geraete".format(len(geraete))
    text = "  <span foreground='{}'>{}</span> <span foreground='{}'>{}</span>  ".format(
        BLAU, icon, GRAU, wort)
    return {"name": "bluetooth", "full_text": text, "markup": "pango"}


def bt_einfuegen(bloecke):
    """Den Bluetooth-Block links neben das WLAN haengen -- die beiden Funk-
    Anzeigen stehen damit beieinander. Ohne WLAN-Block kommt er ans Ende der
    i3status-Bloecke, also noch vor die Glocke."""
    block = bt_block()
    if block is None:
        return bloecke
    stelle = len(bloecke)
    for i, b in enumerate(bloecke):
        if b.get("name") == "wireless":
            stelle = i
            break
    return bloecke[:stelle] + [block] + bloecke[stelle:]


def bt_nachziehen():
    """Nach einem Klick den Zustand nachlesen: Ein- und Ausschalten laeuft
    ueber mehrere Zwischenstufen ("off-enabling"), und der letzte Schritt
    kommt erst nach gut einer Sekunde."""
    for _ in range(4):
        time.sleep(1.5)
        bt_abfragen()
        neu_zeichnen()


def bt_monitor():
    """Auf Aenderungen von org.bluez lauschen -- gleiche Bauart wie monitor()
    fuer dunst, nur auf dem System-Bus.

    Gemeldet wird jedes PropertiesChanged; waehrend einer Geraetesuche sind
    das viele pro Sekunde. Darum wird hoechstens einmal je Sekunde wirklich
    nachgefragt, sonst liefe fuer jedes gefundene Geraet ein Prozess an."""
    global bt_monitor_laeuft
    if not shutil.which("stdbuf"):
        return
    befehl = ["stdbuf", "-oL", "gdbus", "monitor", "--system", "--dest", "org.bluez"]
    while True:
        try:
            lauscher = subprocess.Popen(
                befehl, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                encoding="utf-8", errors="replace")
        except OSError:
            return
        bt_monitor_laeuft = True
        for _zeile in lauscher.stdout:
            if time.monotonic() - bt_gelesen < 1.0:
                bt_uhr_stellen()    # gedrosselt, aber nicht vergessen
                continue
            bt_abfragen()
            neu_zeichnen()
        bt_monitor_laeuft = False
        # bluetoothd neu gestartet oder gar nicht da: warten, dann neu binden
        time.sleep(5)
        bt_abfragen()
        neu_zeichnen()


def ts_wunschpeer():
    """Der Rechnername aus TS_PEER_DATEI, oder None fuer die Selbstsuche."""
    try:
        with open(TS_PEER_DATEI, encoding="utf-8") as d:
            return d.read().strip() or None
    except OSError:
        return None


def ts_abfragen():
    """Zustand von tailscale holen: laeuft das Tailnet, und wie steht es um
    die Gegenstelle.

    Ueber "tailscale status --json" und nicht ueber den Unix-Socket in
    /var/run/tailscale: der Socket ginge auch (er ist fuer alle lesbar), die
    Antwort kommt aber chunked und muesste hier von Hand ausgepackt werden --
    fuer eine Abfrage je halbe Minute lohnt das nicht.
    """
    global ts
    if not shutil.which("tailscale"):
        ts = None
        return
    try:
        fertig = subprocess.run(["tailscale", "status", "--json"],
                                capture_output=True, text=True, timeout=8)
        daten = json.loads(fertig.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        ts = {"zustand": "weg"}         # tailscaled laeuft nicht oder haengt
        return

    zustand = daten.get("BackendState", "")
    if zustand == "Stopped":
        ts = {"zustand": "aus"}
        return
    if daten.get("LoggedOut") or zustand in ("NeedsLogin", "NeedsMachineAuth",
                                             "NoState"):
        # Der wichtigste Zustand ueberhaupt: Schluessel abgelaufen. Das
        # passiert still nach Monaten, und ohne Anzeige faellt es erst auf,
        # wenn eine Verbindung unerklaerlich nicht mehr zustande kommt.
        ts = {"zustand": "login"}
        return
    if zustand == "Starting":
        ts = {"zustand": "startet"}
        return

    peers = list(daten.get("Peer", {}).values())
    wunsch = ts_wunschpeer()
    if wunsch:
        peers = [p for p in peers if p.get("HostName") == wunsch]
    else:
        peers = [p for p in peers if p.get("OS") not in TS_MOBIL]

    ts = {
        "zustand": "an",
        "peers": [{
            "name": p.get("HostName") or "?",
            "online": bool(p.get("Online")),
            # "Relay" taugt nicht als Merkmal fuer eine Umleitung: dort steht
            # immer der zugewiesene DERP-Heimatserver, auch bei einer direkten
            # Verbindung. Direkt ist genau dann, wenn eine CurAddr steht.
            "direkt": bool(p.get("CurAddr")),
        } for p in peers],
    }


def ts_block():
    """Der Tailscale-Block, oder None wenn es kein tailscale gibt."""
    if ts is None:
        return None
    zustand = ts["zustand"]

    if zustand == "aus":
        icon, farbe, wort, wortfarbe = TS_AUS, STUMPF, "aus", STUMPF
    elif zustand == "weg":
        icon, farbe, wort, wortfarbe = TS_AUS, ROT, "weg", ROT
    elif zustand == "login":
        icon, farbe, wort, wortfarbe = TS_LOGIN, ROT, "Login", ROT
    elif zustand == "startet":
        icon, farbe, wort, wortfarbe = TS_AN, GELB, "startet", GRAU
    else:
        peers = ts["peers"]
        drin = [p for p in peers if p["online"]]
        if not peers:
            # Im Tailnet, aber keine Gegenstelle im Blick: dann sagt der Block
            # nur, dass die Verbindung selbst steht.
            icon, farbe, wort, wortfarbe = TS_AN, GRUEN, "an", GRAU
        elif len(peers) == 1:
            peer = peers[0]
            # Gekuerzt und escaped aus demselben Grund wie beim Bluetooth: der
            # Name kommt von aussen und wird als Pango-Markup gelesen.
            name = html.escape(peer["name"][:16])
            if not peer["online"]:
                icon, farbe, wort, wortfarbe = TS_AUS, GRAU, name + " weg", GRAU
            elif peer["direkt"]:
                icon, farbe, wort, wortfarbe = TS_AN, GRUEN, name, GRAU
            else:
                # Erreichbar, aber der Verkehr laeuft ueber einen Relay-Server
                # statt direkt -- geht, ist aber spuerbar langsamer. Gelb ist
                # in dieser Leiste die Farbe fuer "hier stimmt etwas nicht ganz".
                icon, farbe, wort, wortfarbe = TS_AN, GELB, name, GRAU
        else:
            icon = TS_AN if drin else TS_AUS
            farbe = GRUEN if len(drin) == len(peers) else (GELB if drin else GRAU)
            wort, wortfarbe = "{}/{}".format(len(drin), len(peers)), GRAU

    text = "  <span foreground='{}'>{}</span> <span foreground='{}'>{}</span>  ".format(
        farbe, icon, wortfarbe, wort)
    return {"name": "tailscale", "full_text": text, "markup": "pango"}


def ts_einfuegen(bloecke):
    """Rechts neben das WLAN haengen: erst der Funk, dann das lokale Netz,
    dann das Netz darueber. Ohne WLAN-Block ans Ende der i3status-Bloecke,
    also noch vor die Glocke."""
    block = ts_block()
    if block is None:
        return bloecke
    stelle = len(bloecke)
    for i, b in enumerate(bloecke):
        if b.get("name") == "wireless":
            stelle = i + 1
            break
    return bloecke[:stelle] + [block] + bloecke[stelle:]


def ts_nachziehen():
    """Nach einem Klick nachlesen. "tailscale up" meldet sich sofort zurueck,
    die Verbindung zur Gegenstelle steht aber erst ein paar Sekunden spaeter --
    ohne Nachtreten stuende der Block solange auf "weg"."""
    for _ in range(5):
        time.sleep(2)
        ts_abfragen()
        neu_zeichnen()


def ts_umschalten():
    """Tailnet an- oder abschalten.

    Ohne sudo moeglich, weil der eigene Benutzer bei tailscaled als Operator
    eingetragen ist ("tailscale set --operator=..."). Steht dort ein anderer
    Name -- etwa noch der alte Benutzername von vor einer Umbenennung --,
    laeuft der Befehl ins Leere und der Klick bliebe wirkungslos.
    """
    if ts is None:
        return
    aus = ts["zustand"] in ("aus", "weg")
    try:
        subprocess.Popen(["tailscale", "up" if aus else "down"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return
    threading.Thread(target=ts_nachziehen, daemon=True).start()


def vitals_zeigen():
    """Auf die Vitals-Flaeche wechseln.

    Das Dashboard startet beim Anmelden mit und wird per "assign" auf diese
    Flaeche gelegt; im Normalfall ist der Klick also nur ein Wechsel. Wurde
    das Terminal doch einmal geschlossen (die zellij-Session ueberlebt das,
    zu sehen ist davon aber nichts), wird es hier neu gestartet -- sonst
    landete der Klick auf einer leeren Flaeche.
    """
    subprocess.run(["i3-msg", "workspace", "number", VITALS_FLAECHE],
                   capture_output=True, timeout=5)
    try:
        baum = subprocess.run(["i3-msg", "-t", "get_tree"],
                              capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return
    if '"class": "{}"'.format(VITALS_KLASSE) in baum:
        return
    subprocess.Popen(["alacritty", "--class", VITALS_KLASSE, "-e", VITALS_START],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def system_zusammenfassen(bloecke):
    """CPU, Temperatur, RAM und Platte zu einem Block "system" verschmelzen.

    Angezeigt wird im Normalfall nur der CPU-Block, sonst die Bloecke, die
    gerade rot sind: bei knappem Speicher steht also der Speicherwert da, bei
    heisser CPU die Temperatur -- die Leiste bleibt ruhig, meldet sich aber,
    wenn etwas ist. Alles zusammen zeigt ein Linksklick (siehe klicks()).

    Uebernommen wird der fertige full_text von i3status; Icons, Farben und
    Abstaende bleiben damit genau die aus ~/.config/i3status/config, hier
    wird nichts nachgebaut. Die Bloecke werden auch nicht veraendert, nur
    ausgelassen: letzte_zeile haelt dieselben Objekte fuers Neuzeichnen fest.
    """
    teile = [b for b in bloecke if b.get("name") in SYSTEM_MODULE]
    if not teile:
        return bloecke
    warnend = [b for b in teile if WARNROT in b.get("full_text", "")]
    zeigen = warnend or [b for b in teile if b.get("name") == "cpu_usage"] or teile[:1]
    block = {
        "name": "system",
        "full_text": "".join(b.get("full_text", "") for b in zeigen),
        "markup": "pango",
    }
    aus = []
    for b in bloecke:
        if b.get("name") not in SYSTEM_MODULE:
            aus.append(b)
        elif b is teile[0]:         # der neue Block sitzt an der Stelle des ersten
            aus.append(block)
    return aus


def glocken_block():
    if anzahl:
        text = "  <span foreground='{}'>{}</span> <span foreground='{}'>{}</span>   ".format(
            GELB, GLOCKE, GRAU, anzahl)
    else:
        text = "  <span foreground='{}'>{}</span>   ".format(STUMPF, GLOCKE_AUS)
    return {
        "name": "dunst",
        "full_text": text,
        "markup": "pango",
        "separator": False,
        "separator_block_width": 0,
    }


def ausgeben(bloecke):
    """Eine Zeile des i3bar-Protokolls schreiben. Die Glocke kommt ans Ende,
    denn i3bar zeichnet den ersten Block links und den letzten rechts.

    ensure_ascii=False: die Icons sollen als echtes UTF-8 rausgehen wie bei
    i3status auch, nicht als \\uXXXX-Ersatzpaare."""
    bloecke = ts_einfuegen(bt_einfuegen(wlan_block_ersetzen(
        system_zusammenfassen(bloecke))))
    with schloss:
        sys.stdout.write(json.dumps(bloecke + [glocken_block()], ensure_ascii=False) + ",\n")
        sys.stdout.flush()


def neu_zeichnen():
    """Leiste sofort neu ausgeben, ohne auf die naechste i3status-Zeile zu warten."""
    if letzte_zeile is not None:
        ausgeben(letzte_zeile)


def monitor():
    """Auf Aenderungen von historyLength lauschen (siehe Kopf)."""
    global anzahl, monitor_laeuft
    muster = re.compile(r"'historyLength': <uint32 (\d+)>")
    # stdbuf -oL ist hier keine Kosmetik: gdbus schreibt ueber die C-Bibliothek
    # und puffert blockweise, sobald die Ausgabe kein Terminal ist. Ohne den
    # Zeilenpuffer kaeme das erste Signal erst nach ein paar Kilobyte an --
    # die Zahl an der Glocke haette tagelang stillgestanden.
    if not shutil.which("stdbuf"):
        return              # ohne Zeilenpuffer lieber gleich abfragen lassen
    befehl = ["stdbuf", "-oL", "gdbus", "monitor", "--session", "--dest", DIENST]
    while True:
        try:
            lauscher = subprocess.Popen(
                befehl, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                encoding="utf-8", errors="replace")
        except OSError:
            return                      # kein gdbus -- dann eben abfragen
        monitor_laeuft = True
        for zeile in lauscher.stdout:
            treffer = muster.search(zeile)
            if treffer:
                anzahl = int(treffer.group(1))
                neu_zeichnen()
        monitor_laeuft = False
        # dunst neu gestartet oder D-Bus weg: kurz warten, dann neu verbinden
        time.sleep(5)
        anzahl = verlauf_laenge()
        neu_zeichnen()


def nebenlaeufig(arbeit):
    """Eine Klickaktion in einem eigenen Thread erledigen.

    WARUM: i3bar schickt die Klicks durch eine Pipe und wartet, bis sie
    angenommen sind. Wird in klicks() selbst gearbeitet, laeuft die Pipe voll
    und i3bar blockiert beim Schreiben -- dann reagiert die GANZE Leiste
    nicht mehr, auch die Arbeitsflaechen-Knoepfe, die i3bar sonst allein
    bedient. Hier wird darum nur verteilt; gearbeitet wird nebenan.
    """
    threading.Thread(target=arbeit, daemon=True).start()


def dunst_klick(taste):
    """Verlauf oeffnen oder leeren, danach die Zahl an der Glocke nachziehen."""
    global anzahl
    if taste == 1:
        subprocess.Popen([VERLAUF])
    elif taste == 3:
        subprocess.run(
            ["gdbus", "call", "--session", "--dest", DIENST,
             "--object-path", OBJEKT, "--method",
             SCHNITT + ".NotificationClearHistory"],
            capture_output=True)
    anzahl = verlauf_laenge()
    neu_zeichnen()


def bluetooth_klick(taste):
    if taste == 1:
        subprocess.Popen([BLUETOOTH, "um"])
        bt_nachziehen()
    elif taste == 3:
        subprocess.Popen([BLUETOOTH])


def klicks():
    """Klick-Ereignisse von i3bar lesen und verteilen. Sie kommen als
    JSON-Strom: erst "[", dann je Klick ein Objekt, ab dem zweiten mit
    fuehrendem Komma.

    Hier wird nichts ausgefuehrt, was laenger als ein Wimpernschlag dauert --
    siehe nebenlaeufig().
    """
    for zeile in sys.stdin:
        zeile = zeile.strip().lstrip(",")
        if not zeile or zeile == "[":
            continue
        try:
            ereignis = json.loads(zeile)
        except ValueError:
            continue
        name = ereignis.get("name")
        taste = ereignis.get("button")

        if name == "volume":
            if taste == 1:
                subprocess.Popen([OSD, "stumm"])
            elif taste == 4:
                subprocess.Popen([OSD, "lauter"])
            elif taste == 5:
                subprocess.Popen([OSD, "leiser"])
            continue

        if name == "system":
            if taste == 1:
                nebenlaeufig(vitals_zeigen)
            continue

        if name == "wireless":
            if taste == 1:
                nebenlaeufig(wlan_umschalten)
            continue

        if name == "tailscale":
            if taste == 1:
                nebenlaeufig(ts_umschalten)
            continue

        if name == "bluetooth":
            nebenlaeufig(lambda: bluetooth_klick(taste))
            continue

        if name == "dunst":
            nebenlaeufig(lambda: dunst_klick(taste))


def main():
    global anzahl, letzte_zeile, ts_zaehler
    # Ein- und Ausgabe fest auf UTF-8: die Icons sind Nerd-Font-Zeichen, und
    # welche Locale i3bar dem Skript vererbt, ist nicht garantiert.
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stdin.reconfigure(encoding="utf-8", errors="replace")
    i3status = subprocess.Popen(["i3status"], stdout=subprocess.PIPE,
                                encoding="utf-8", errors="replace")
    anzahl = verlauf_laenge()
    bt_abfragen()
    ts_abfragen()

    # Kopfzeile von i3status uebernehmen und um click_events ergaenzen
    kopf = json.loads(i3status.stdout.readline())
    kopf["click_events"] = True
    print(json.dumps(kopf), flush=True)
    print(i3status.stdout.readline().strip(), flush=True)     # die oeffnende "["

    threading.Thread(target=klicks, daemon=True).start()
    threading.Thread(target=monitor, daemon=True).start()
    threading.Thread(target=bt_monitor, daemon=True).start()

    for zeile in i3status.stdout:
        zeile = zeile.strip().lstrip(",")
        if not zeile:
            continue
        try:
            bloecke = json.loads(zeile)
        except ValueError:
            continue
        letzte_zeile = bloecke
        if not monitor_laeuft:          # Notnagel, falls der Monitor fehlt
            anzahl = verlauf_laenge()
        if not bt_monitor_laeuft:       # dasselbe fuer den Bluetooth-Block
            bt_abfragen()
        ts_zaehler += 1                 # gedrosselt, siehe TS_TAKT
        if ts_zaehler % TS_TAKT == 0:
            ts_abfragen()
        ausgeben(bloecke)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
