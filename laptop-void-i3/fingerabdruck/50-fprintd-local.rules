// Fingerabdruck (fprintd) ohne logind-Sitzung.
//
// Void mit i3 hat hier keinen Sitzungs-Tracker (elogind laeuft nicht), polkit
// kann den angemeldeten Benutzer deshalb nie als "aktive Sitzung" einstufen und
// wuerde die fprintd-Aktionen mit ihrem Standard (allow_active) immer ablehnen.
// Mitglieder von wheel duerfen darum eigene Finger anlernen und pruefen.
// Das Anlernen fuer *andere* Benutzer (setusername) bleibt root vorbehalten.
polkit.addRule(function(action, subject) {
    if ((action.id == "net.reactivated.fprint.device.enroll" ||
         action.id == "net.reactivated.fprint.device.verify") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
