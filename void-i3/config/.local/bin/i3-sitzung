#!/bin/sh
# i3-sitzung  -- Sitzungsmenue auf F12 (Zahnradtaste)
#
# Die Taste meldet seit dem hwdb-Remap KEY_F19, in X also das Keysym "F19";
# siehe /etc/udev/hwdb.d/61-hp-envy-fkeys.hwdb. Ohne diesen Remap sendet sie
# KEY_SETUP, wofuer X11 gar kein Keysym kennt -- die Taste waere nicht bindbar.
#
# Das Menue ist ein Icon-Raster wie der App-Drawer auf Super+Space (Theme:
# ~/.config/rofi/sitzung.rasi) und zeigt genau drei Kacheln: Abmelden,
# Neustart, Herunterfahren. Alle drei koennen Arbeit vernichten, darum fragt
# jede noch einmal nach -- die Rueckfrage bleibt bewusst eine schmale Liste.
#
# Sperren und Bereitschaft stehen nicht im Raster, die Funktionen gibt es aber
# weiter: "i3-sitzung sperren" haengt an $mod+l und wird ausserdem von
# /etc/acpi/deckel.sh aufgerufen, wenn der Deckel zugeht. "i3-sitzung
# bereitschaft" ist absichtlich ohne Taste und nur von Hand aufrufbar.
#
# Neustart/Ausschalten/Bereitschaft laufen ueber sudo. Die dafuer noetige
# passwortfreie Ausnahme steht in /etc/sudoers.d/10-sitzung -- ohne sie
# bliebe das Menue an der Passwortfrage haengen, weil rofi kein Terminal
# fuer die Eingabe hat.

RASTER="$HOME/.config/rofi/sitzung.rasi"
ZUSTAND="$HOME/.cache/sperrbild/zustand"

# Takt des Fingerabdruck-Waechters in Sekunden und die Zahl der Takte, nach
# denen ein nicht zurueckkehrender fprintd-verify abgebrochen wird.
# 0,25 s * 120 = 30 s Geduld -- laenger braucht kein Versuch, und ein
# Auflegen wird trotzdem in einem Augenblick bemerkt.
TAKT=0.25
GEDULD=120

# Zeilen im dmenu-Format mit Symbol: Text, NUL, "icon", 0x1f, Symbolname.
# Die Symbole kommen aus Papirus-Dark (icon-theme in config.rasi); rofi
# skaliert die SVGs auf die 4em aus dem Theme hoch.
zeilen() {
    printf 'Abmelden\0icon\037system-log-out\n'
    printf 'Neustart\0icon\037system-reboot\n'
    printf 'Herunterfahren\0icon\037system-shutdown\n'
}

# Rueckfrage: schmale Liste im Standardthema. -no-show-icons, weil hier
# keine Symbole mitgegeben werden und sonst links eine leere Spalte bliebe.
frage_nach() {
    [ "$(printf 'Nein\nJa\n' | rofi -dmenu -i -no-show-icons -p "$1" -lines 2)" = "Ja" ]
}

# ---------------------------------------------------------------- Sperren
#
# Gesperrt wird mit xsecurelock. Es trennt drei Dinge in eigene Prozesse: das
# Fenster mit den Tastatur- und Mausgriffen, das Hintergrundbild (Saver-Modul)
# und die Anmeldemaske. Stuerzt eines der beiden letzteren ab, bleibt der
# Schirm trotzdem gesperrt -- deshalb hier und nicht i3lock, das ausser einer
# Farbe oder einem PNG ohnehin nichts anzeigen kann.
#
# Das Bild liefert /usr/libexec/xsecurelock/saver_ehwaz, die Anmeldemaske
# auth_x11. Die Maske erscheint nicht sofort: xsecurelock startet sie erst auf
# Tastendruck -- oder auf das Signal USR2, das der Fingerwaechter weiter unten
# nach einem misslungenen Versuch schickt. Genau das ist die gewuenschte
# Abfolge: erst nur der Fingerabdruck, das Passwortfeld erst, wenn der Finger
# nicht erkannt wurde.
#
# Die Farben sind dieselben wie in ~/.config/rofi/config.rasi, damit die Maske
# nahtlos in der Flaeche sitzt, die das Bild schon mitbringt. Name und
# Rechnername stehen ebenfalls im Bild, xsecurelock soll sie nicht ein zweites
# Mal darueber schreiben -- daher SHOW_USERNAME und SHOW_HOSTNAME auf 0.
# BLANK_TIMEOUT -1 schaltet das Schwarzschalten ab; sonst waere das Bild nach
# kurzer Zeit weg und mit ihm der Hinweis auf den Finger.
#
# NO_COMPOSITE=1 ist die Bedingung fuer die Animation. Normalerweise legt
# xsecurelock sein Fenster in das Composite-Overlay -- dort haengt es nicht
# mehr am Wurzelfenster, und picom sieht es gar nicht. Auf einem Xvfb-Schirm
# nachgesehen: mit Overlay listet der Fensterbaum nur den "obscurer", ohne es
# genau ein Fenster der Klasse xsecurelock direkt unter der Wurzel -- und nur
# das kann die Regel in ~/.config/picom.conf hereinfliegen lassen.
#
# Der Preis: ein Compositor koennte theoretisch etwas darueber zeichnen, etwa
# eine Benachrichtigung. xsecurelock holt sein Fenster deshalb von sich aus
# regelmaessig nach vorn. Ganz ausschliessen laesst sich ein kurzes Aufblitzen
# damit nicht.
starte_sperre() {
    XSECURELOCK_SAVER=saver_ehwaz \
    XSECURELOCK_NO_COMPOSITE=1 \
    XSECURELOCK_BACKGROUND_COLOR='#161616' \
    XSECURELOCK_AUTH_BACKGROUND_COLOR='#1e1e1e' \
    XSECURELOCK_AUTH_FOREGROUND_COLOR='#e8e8e8' \
    XSECURELOCK_AUTH_WARNING_COLOR='#fb4934' \
    XSECURELOCK_SHOW_USERNAME=0 \
    XSECURELOCK_SHOW_HOSTNAME=0 \
    XSECURELOCK_SHOW_KEYBOARD_LAYOUT=0 \
    XSECURELOCK_BURNIN_MITIGATION=0 \
    XSECURELOCK_BLANK_TIMEOUT=-1 \
    XSECURELOCK_PASSWORD_PROMPT=asterisks \
    XSECURELOCK_FONT='Red Hat Mono:size=16' \
    setsid xsecurelock >/dev/null 2>&1 &
}

sperren() {
    uid=$(id -u)

    # Schon gesperrt? Dann nichts tun -- zwei Sperren uebereinander wuerden
    # sich gegenseitig die Tastaturgriffe wegnehmen.
    if pgrep -u "$uid" -x xsecurelock >/dev/null 2>&1; then
        return 0
    fi

    mkdir -p "$HOME/.cache/sperrbild"
    : > "$ZUSTAND"          # immer im Ausgangszustand beginnen

    starte_sperre

    # Warten, bis die Sperre wirklich steht. xsecurelock scheitert, wenn ein
    # anderes Fenster gerade die Tastatur greift (offenes rofi, Menue,
    # Vollbildspiel). Das muss der Aufrufer erfahren: gleich danach klappt
    # vielleicht der Deckel zu und der Rechner schlaeft ein.
    n=0
    while [ "$n" -lt 50 ]; do
        pgrep -u "$uid" -x xsecurelock >/dev/null 2>&1 && break
        sleep 0.1
        n=$((n + 1))
    done

    if ! pgrep -u "$uid" -x xsecurelock >/dev/null 2>&1; then
        logger -t i3-sitzung "xsecurelock kam nicht hoch -- Schirm bleibt offen"
        return 1
    fi

    finger_entsperren
    return 0
}

# Fingerabdruck statt Passwort: solange die Sperre laeuft, im Hintergrund auf
# einen passenden Finger warten und xsecurelock dann beenden. Die
# Passworteingabe geht parallel weiter.
#
# Warum der Finger nicht in /etc/pam.d/xsecurelock steht, wo er doch bei sudo
# und login ueber PAM laeuft: pam_fprintd wuerde den Sensor selbst greifen,
# und dann streiten sich zwei Prozesse darum. Ausserdem kaeme der Text dann
# von pam_fprintd ("Place your finger...") statt aus dem eigenen Bild.
#
# Wird per Passwort entsperrt, muss der wartende fprintd-verify sterben --
# sonst haelt er den Sensor belegt, und sudo bekaeme keinen Finger mehr.
# Laeuft nur, wenn fprintd da ist und Finger angelernt sind; sonst wuerde die
# Schleife jede Sekunde ins Leere fragen. Siehe fingerabdruck/README.md.
finger_entsperren() {
    command -v fprintd-verify >/dev/null 2>&1 || return 0
    fprintd-list "$(id -un)" 2>/dev/null | grep -q '^Fingerprints for user' || return 0
    uid=$(id -u)

    # Reste eines frueheren Laufs wegraeumen. Hier stand frueher das
    # Gegenteil -- "laeuft schon einer? dann nichts tun" -- und das war der
    # Grund, warum der Finger manchmal gar nicht reagierte: ein haengen
    # gebliebener fprintd-verify liess den Waechter erst gar nicht starten,
    # und der Sensor blieb bis zum Neustart stumm.
    pkill -u "$uid" -x fprintd-verify 2>/dev/null

    (
        ausgabe=$(mktemp) || exit 0
        while pgrep -u "$uid" -x xsecurelock >/dev/null; do
            fprintd-verify >"$ausgabe" 2>&1 &
            pruefer=$!

            # Auf das Ergebnis warten -- aber nicht endlos. Nach dem
            # Aufwachen aus der Bereitschaft kann fprintd-verify haengen
            # bleiben (Erklaerung in /etc/zzz.d/resume/10-fingerabdruck);
            # ohne diese Schranke wartete der Waechter dann fuer immer und
            # der Finger waere tot, obwohl die Sperre noch steht.
            #
            # Gezaehlt wird in Runden zu $TAKT, nicht in Sekunden: der Takt
            # bestimmt zugleich, wie schnell die Sperre nach dem Auflegen
            # aufgeht. Eine ganze Sekunde war hier deutlich zu traege.
            runden=0
            while kill -0 "$pruefer" 2>/dev/null; do
                if ! pgrep -u "$uid" -x xsecurelock >/dev/null; then
                    kill "$pruefer" 2>/dev/null
                    rm -f "$ausgabe"
                    exit 0
                fi
                runden=$(( runden + 1 ))
                if [ "$runden" -ge "$GEDULD" ]; then
                    kill "$pruefer" 2>/dev/null
                    wait "$pruefer" 2>/dev/null
                    continue 2
                fi
                sleep "$TAKT"
            done

            if wait "$pruefer"; then
                pkill -u "$uid" -x xsecurelock
                rm -f "$ausgabe"
                exit 0
            fi
            # Kein Treffer: das Bild auf "Try again" umlegen und mit USR2 die
            # Passwortmaske einblenden. Nur bei einem echten no-match --
            # bricht fprintd aus einem anderen Grund ab (Sensor belegt, Dienst
            # weg), soll nichts Rotes dastehen.
            if grep -q 'no-match' "$ausgabe" 2>/dev/null; then
                echo nochmal > "$ZUSTAND"
                pkill -u "$uid" -USR2 -x xsecurelock
            fi
            # Gleich wieder scharf schalten. Die Pause ist bewusst kurz: in
            # ihr ist der Sensor blind, und wer den Finger nach einem
            # Fehlversuch sofort wieder auflegt, soll nicht ins Leere fassen.
            sleep "$TAKT"
        done
        rm -f "$ausgabe"
    ) >/dev/null 2>&1 &
}

bereitschaft() {
    # Erst sperren, dann schlafen -- sonst liegt der entsperrte Schirm beim
    # Aufwachen offen da. sperren kehrt zurueck, sobald die Sperre steht.
    sperren
    sudo zzz
}

case "$1" in
    sperren)      sperren;      exit $? ;;
    bereitschaft) bereitschaft; exit 0  ;;
esac

auswahl=$(zeilen | rofi -dmenu -i -theme "$RASTER")

case "$auswahl" in
    Abmelden)
        frage_nach "Abmelden?" && i3-msg exit
        ;;
    Neustart)
        frage_nach "Neustart?" && sudo reboot
        ;;
    Herunterfahren)
        frage_nach "Herunterfahren?" && sudo poweroff
        ;;
    *)
        # Abbruch mit Escape: rofi liefert eine leere Zeile
        exit 0
        ;;
esac
