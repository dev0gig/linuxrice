#!/bin/sh
# Dashboard-Pane "Sensoren", eine von zwei Spalten.
#
# Aufruf: vitals-sensoren alle    -> alles in einer Spalte (Vorgabe)
#         vitals-sensoren cpu     -> nur die CPU-Kerne
#         vitals-sensoren system  -> SSD, WLAN, Luefter, Akku
#
# Die Aufteilung steckt in den Konfigurationsdateien: "show" und "hide"
# gelten pro Abschnitt, darum braucht jede Variante eine eigene Datei.
#
# Im Dashboard laeuft davon die Variante "alle" in einem Pane neben dem
# Datentraeger-Pane. Die Aufteilung cpu/system stammt aus dem frueheren
# Versuch mit zwei Sensorspalten und bleibt als Reserve erhalten.
#
# Zur Breite: glances braucht pro Pane 25 nutzbare Spalten, sonst laesst es
# die Wertspalte komplett weg und es stehen nur die Beschriftungen da. Der
# zellij-Rahmen kostet zwei weitere, das Pane muss also mindestens 27 breit
# sein. Und in der Hoehe braucht die Liste 15 Zeilen Innenraum -- bei 13
# fielen "Luefter 2" und "Akku" still weg. Die Zahlen stehen im Layout
# ~/.config/zellij/layouts/dashboard.kdl und sind dort begruendet.
case "${1:-alle}" in
    alle)   KONFIG=/home/user/.config/glances/sensoren-alle.conf ;;
    cpu)    KONFIG=/home/user/.config/glances/sensoren-cpu.conf ;;
    system) KONFIG=/home/user/.config/glances/sensoren-system.conf ;;
    *)      echo "Aufruf: $0 alle|cpu|system" >&2; exit 2 ;;
esac

exec glances \
    --config "$KONFIG" \
    --disable-plugin all \
    --enable-plugin sensors \
    --disable-check-update \
    --disable-cursor \
    -t 3
