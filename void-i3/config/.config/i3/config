# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
#
# Groesse 11 statt 9: die einzigen Titelleisten hier sind die der
# Claude-Sitzungen (siehe die for_window-Regeln weiter unten), und die sollen
# gut lesbar sein. Nachgemessen ueber deco_rect.height in "i3-msg -t get_tree":
# 11 -> 24 px, 12 -> 26, 13 -> 28, 14 -> 30. 11 ist zugleich die Groesse der
# Statusleiste, Leiste oben und Titelleiste darunter passen also zusammen.
# Pango-Syntax: die Groesse steht EINMAL am Ende hinter der Familienliste --
# "Red Hat Mono 9, Symbols Nerd Font Mono 9" war falsch geschrieben.
font pango:Red Hat Mono, Symbols Nerd Font Mono 11

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
# dex startet .desktop-Autostarteintraege. Nicht installiert und hier
# auch nicht gewollt -- was starten soll, steht weiter unten direkt.
# exec --no-startup-id dex --autostart --environment i3

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
# Bildschirmsperre vor dem Suspend. Braucht das Paket xss-lock, das hier
# nicht installiert ist -- die Zeile lief also ins Leere.
# exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c 161616

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
# Netzwerk laeuft ueber dhcpcd und wpa_supplicant, nicht ueber den
# NetworkManager -- nm-applet ist gar nicht installiert.
# exec --no-startup-id nm-applet

# ---- Autostart: feste Belegung der Arbeitsflaechen 1 bis 4 ----
#   1: browser   2: lokales Terminal
#   3: SSH-Sitzung   4: vitals (btop, volle Flaeche)
#
# Ab 5 aufwaerts sind die Flaechen frei und werden nach dem laufenden
# Programm benannt.
#
# Jedes Autostart-Fenster bekommt eine eigene Fensterklasse, damit nur genau
# DIESES Fenster zugeordnet wird -- normale Alacritty-Fenster (Ctrl+Alt+t)
# verhalten sich unveraendert.
#
# Wichtig das Schluesselwort "number": die Flaechen heissen durch
# ~/.local/bin/i3-workspace-names dauerhaft "1: browser", "3: Server" usw.
# Ohne "number" wuerde i3 den Namen exakt gegen "1" pruefen, keinen Treffer
# finden und eine zweite, gleichnamige Flaeche danebenlegen.
assign [class="(?i)google-chrome"] number 1
assign [class="autostart-term"]   number 2
assign [class="remote-term"]      number 3
assign [class="vitals-dashboard"] number 4

exec --no-startup-id ~/.local/bin/chrome
exec --no-startup-id alacritty --class autostart-term
exec --no-startup-id alacritty --class remote-term -e ~/.local/bin/remote-shell
exec --no-startup-id alacritty --class vitals-dashboard -e ~/.local/bin/vitals-btop

# Das Dashboard soll die volle Flaeche haben: kein Rahmen, keine Titelleiste.
for_window [class="vitals-dashboard"] border none

exec --no-startup-id i3-msg workspace number 1

# ---- Ton ----
# PipeWire starten; ueber die Drop-ins in /etc/pipewire/pipewire.conf.d/
# zieht es WirePlumber (Geraeteverwaltung) und pipewire-pulse (PulseAudio-
# Schnittstelle, die auch i3status und die XF86Audio-Tasten nutzen) mit hoch.
# exec_always, damit der Ton nach "i3 restart" wieder steht -- die pgrep-Wache
# verhindert, dass ein zweiter Server auf denselben Socket rennt.
exec_always --no-startup-id "pgrep -x pipewire > /dev/null || pipewire"

# ---- Benachrichtigungen ----
# dunst ist der D-Bus-Dienst auf org.freedesktop.Notifications. Ohne ihn
# verschwinden Meldungen von Chrome & Co. spurlos -- genau das war hier
# lange der Fall, weil gar kein Dienst lief.
#
# Streng genommen startet ihn der D-Bus beim ersten Aufruf selbst
# (/usr/share/dbus-1/services/org.knopwob.dunst.service). Hier steht er
# trotzdem, damit er von Sitzungsbeginn an bereit ist statt erst bei der
# ersten Meldung. Die pgrep-Wache verhindert einen zweiten Daemon nach
# "i3 restart".
exec_always --no-startup-id "pgrep -x dunst > /dev/null || dunst"

# Warnt bei knappem Akku und heisser CPU. Beendet einen etwaigen Vorgaenger
# selbst ueber eine PID-Datei -- ein "pkill -f" hier wuerde die eigene
# exec-Shell mit killen.
exec_always --no-startup-id ~/.local/bin/akku-wache

# Zweite, getrennte Wache: sie misst die Untaetigkeit (xprintidle) und setzt
# die drei Energiezeiten durch -- Bildschirm dunkel (per DPMS), Sperren und
# Bereitschaft, jede getrennt fuer Netzteil und Akkubetrieb. Eingestellt wird
# das mit einem Linksklick auf den Akku in der Leiste, die Werte stehen in
# ~/.config/akku/einstellungen und werden bei jedem Durchlauf neu gelesen.
#
# Absichtlich nicht in akku-wache mit drin: die warnt (Ton, Meldung), diese
# hier greift ein (sperrt, legt schlafen). Zwei sehr verschiedene Dinge, und
# ein Fehler in der einen soll die andere nicht mitreissen. Beendet ihren
# Vorgaenger ueber eine eigene PID-Datei.
exec_always --no-startup-id ~/.local/bin/akku wache

# Kurzer Ton beim Ein- und Ausstecken des Netzteils. Eigenes Skript, weil es
# im Zwei-Sekunden-Takt schaut -- die Akkuwache darf dafuer ruhig weiter
# gemaechlich pollen.
exec_always --no-startup-id ~/.local/bin/netz-ton

# Ein Klick auf eine Meldung holt das Programm nach vorn, von dem sie kommt.
# dunst kann das nicht selbst -- an einen Mausklick laesst sich dort nur eine
# seiner eingebauten Aktionen binden, kein eigenes Skript. Der Dienst hoert
# darum am D-Bus mit, welche Meldung weggeklickt wurde, und fokussiert das
# passende Fenster ueber i3. Beendet seinen Vorgaenger per PID-Datei.
exec_always --no-startup-id ~/.local/bin/meldung-klick

# Die beiden LEDs in F8 (Mikrofon) und F5 (Ton) einmal an den tatsaechlichen
# Mute-Zustand angleichen. Noetig, weil der Codec sie beim Booten in seinem
# Ruhezustand laesst -- sie blieben sonst dunkel, obwohl vielleicht stumm
# geschaltet ist.
exec_always --no-startup-id ~/.local/bin/mikro-led auto
exec_always --no-startup-id ~/.local/bin/ton-led auto

# Bluetooth so hochkommen lassen, wie es zuletzt stand. bluez tut das nicht
# von sich aus: "AutoEnable=false" in /etc/bluetooth/main.conf laesst den
# Adapter nach jedem Neustart aus, ganz gleich wie er vorher war. Das Skript
# merkt sich jedes An und Aus in ~/.local/state/bluetooth-zustand und stellt
# es hier nach -- war es aus, passiert nichts. Dasselbe nach der Bereitschaft
# ueber /etc/zzz.d/resume/20-funk.
#
# WLAN braucht kein Gegenstueck: das ist ausnahmslos an, dafuer sorgen die
# udev-Regel /etc/udev/rules.d/60-rfkill-unblock.rules beim Boot und derselbe
# Aufwach-Hook.
exec_always --no-startup-id ~/.local/bin/bluetooth wiederherstellen

# ---- Hintergrundbild ----
# exec_always: laeuft auch bei "i3 reload/restart" wieder, damit das Bild
# nach einem Neustart des WM sofort wieder steht.
exec_always --no-startup-id ~/.config/i3/wallpaper.sh

# Touchpad-Gesten (4 Finger = Arbeitsflaeche wechseln)
exec_always --no-startup-id libinput-gestures-setup restart

# Arbeitsflaechen automatisch nach dem laufenden Programm benennen
# ("2" -> "2: Terminal"). Die Nummer bleibt vorn, darum funktionieren
# "workspace number N" und die assign-Regeln oben unveraendert weiter.
# Das Skript beendet eine evtl. noch laufende Vorgaenger-Instanz selbst
# (PID-Datei) -- ein "pkill -f" hier wuerde die eigene exec-Shell mit killen.
exec_always --no-startup-id ~/.local/bin/i3-workspace-names

# Laesst die Titelleiste einer Claude-Sitzung blinken, die auf eine Antwort
# wartet -- fuer den Fall, dass man waehrend der Arbeit weggeht. Zweiter, vom
# urgent-Flag unabhaengiger Weg: Alacritty setzt urgent bei der Terminal-Glocke
# nur, wenn das Fenster NICHT den Fokus hat -- und genau dann passiert dort
# nichts, wenn die Sitzung beim Weggehen vorne lag.
exec_always --no-startup-id ~/.local/bin/claude-warte-blinken

# Verlauf der Zwischenablage mitschreiben (Mod+v zeigt ihn an).
# clipmenud haelt sich an $XDG_RUNTIME_DIR, das ist tmpfs -- der Verlauf ist
# beim Neustart weg und liegt nie dauerhaft auf der Platte.
exec_always --no-startup-id "pgrep -x clipmenud > /dev/null || clipmenud"

# Verlauf der Benachrichtigungen (dasselbe wie ein Klick auf die Glocke
# ganz rechts in der Leiste).
bindsym $mod+n exec --no-startup-id ~/.local/bin/benachrichtigungen

# Wallpaper wechseln: Auswahl per rofi aus ~/Bilder/Wallpapers
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/wallpaper

# ---- Ton (F5 / F6 / F7) ----
# Die Tasten rufen nicht mehr direkt pactl auf, sondern ~/.local/bin/osd.
# Das Skript aendert den Wert, blendet einen Balken ein (dunst zeichnet ihn
# aus dem Hinweis "int:value") und stoesst i3status selbst an -- das frueher
# hier stehende $refresh_i3status steckt jetzt am Ende des Skripts.
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/osd lauter
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/osd leiser
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/osd stumm
# F8 (Mikrofon): die Taste meldet von Haus aus KEY_MICMUTE (evdev 248), das
# waere X-Keycode 256 -- X11 kann aber nur bis 255, sie kam hier also nie an.
# /etc/udev/hwdb.d/61-hp-envy-fkeys.hwdb biegt sie auf KEY_F20 um, und <FK20>
# traegt im Layout ohnehin das Keysym XF86AudioMicMute. Darum funktioniert
# genau dieses Binding jetzt unveraendert.
bindsym XF86AudioMicMute exec --no-startup-id ~/.local/bin/osd mikro

# ---- Bildschirmhelligkeit (F2 / F3) ----
# Die Tasten melden KEY_BRIGHTNESSDOWN/UP, in X heissen sie XF86MonBrightness*.
# brightnessctl schreibt nach /sys/class/backlight/intel_backlight; die
# udev-Regel des Pakets (90-brightnessctl.rules) legt diese Datei auf die
# Gruppe "video", in der "user" ist -- darum braucht es hier kein sudo.
# "-n5" haelt einen Mindestwert: F2 kann den Schirm nicht auf schwarz drehen.
# Die Schrittweite (20%) und der Mindestwert stehen jetzt im Skript.
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/osd dunkler
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/osd heller

# ---- Medienwiedergabe (F9 / F10 / F11) ----
# Trotz der Symbole << und >> senden die Tasten Titel zurueck/vor
# (KEY_PREVIOUSSONG / KEY_NEXTSONG), nicht Spulen -- entsprechend die Befehle.
# playerctl spricht MPRIS ueber den Sitzungs-D-Bus; ~/.xinitrc startet i3 mit
# "dbus-run-session", darum erben diese Bindings den richtigen Bus.
# Chrome meldet sich dort von selbst an, sobald Ton oder Video laeuft.
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next

# ---- Hilfe (F1) ----
# Die Taste sendet NICHT KEY_HELP, wie das Symbol vermuten laesst, sondern
# Super+F1 -- HP bildet damit die Windows-Tastenkombination fuer die Hilfe
# nach. Nachgemessen an den Rohdaten von /dev/input/event0: erst KEY_LEFTMETA,
# dann KEY_F1. Ein frueheres "bindsym Help" konnte deshalb nie greifen.
# Das Skript liest die Tastenbelegung aus dieser Datei und zeigt sie in rofi.
bindsym $mod+F1 exec --no-startup-id ~/.local/bin/i3-hilfe

# ---- Sitzungsmenue (F12) ----
# Sperren, Bereitschaft, Abmelden, Neustart, Herunterfahren.
#
# Warum bindcode statt bindsym: die Zahnradtaste sendet den Scancode 0x21a6,
# den der hp-wmi-Treiber nicht in seiner Tabelle hat -- er meldet sie deshalb
# als KEY_UNKNOWN (evdev 240), in X also Keycode 248. Ein hwdb-Remap scheitert
# hier, weil sparse_keymap nur *vorhandene* Scancodes umschreiben laesst und
# neue mit EINVAL ablehnt. Keycode 248 wiederum traegt in symbols/inet
# ausdruecklich NoSymbol, es gibt also keinen Namen, den bindsym nutzen
# koennte. Der Keycode selbst kommt aber sauber an -- und genau den bindet
# bindcode.
bindcode 248 exec --no-startup-id ~/.local/bin/i3-sitzung

# Sperren steht nicht mehr im Raster -- drei Kacheln sollten es sein.
# Das Skript kennt den Punkt aber weiter als eigenen Aufruf.
bindsym $mod+l exec --no-startup-id ~/.local/bin/i3-sitzung sperren

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# Terminal: Alacritty auf Strg+Alt+T (Mod1 = Alt)
bindsym Control+Mod1+t exec --no-startup-id alacritty

# kill focused window
#
# Alle drei Bindungen gehen ABSICHTLICH nicht auf das Vitals-Dashboard auf
# Arbeitsflaeche 4. btop selbst laesst sich dort ganz normal bedienen --
# nur zumachen soll es niemand koennen. Die zweite Haelfte davon steckt in
# ~/.local/bin/vitals-btop: die Schleife dort startet btop sofort neu,
# wenn es ueber "q", Strg+C oder das Esc-Menue beendet wird.
#
# Der Ausschluss steckt im Kriterium vor dem Befehl. i3 nimmt PCRE, der
# negative Lookahead "(?!...)" ist also erlaubt. con_id="__focused__" MUSS
# dabeistehen: ohne ihn trifft das Kriterium JEDES Fenster ausser dem
# Dashboard, und "kill" wuerde sie alle auf einmal schliessen.
#
# Nachgemessen ueber "title_format" (faellt nicht auf, weil default_border
# none keine Titelleisten zeichnet): mit Fokus auf Chrome trifft das
# Kriterium genau Chrome, mit Fokus auf dem Dashboard gar nichts.
bindsym $mod+Shift+q [con_id="__focused__" class="^(?!vitals-dashboard$).*$"] kill
# Fenster schliessen mit Strg+q (i3 faengt die Taste global ab,
# Programme sehen sie also nicht mehr selbst)
#
# Terminalfenster sind hier ABSICHTLICH ausgenommen: sie gehen nur ueber
# Strg+Shift+q zu, damit Strg+q dort nicht aus Versehen eine laufende
# Sitzung wegraeumt. Alle Terminals sind Alacritty, laufen aber unter
# eigenen Klassen (siehe die "assign"-Zeilen oben), darum die Aufzaehlung
# im Lookahead -- eine neue Terminalklasse muss hier mit eingetragen
# werden. Achtung: die Taste bleibt trotzdem von i3 gegriffen, im
# Terminal kommt sie also weiterhin nicht an, sie tut dort jetzt nur
# nichts mehr.
bindsym Control+q [con_id="__focused__" class="^(?!Alacritty$|autostart-term$|remote-term$|vitals-dashboard$).*$"] kill
# Strg+Shift+q schliesst zusaetzlich auch Terminalfenster -- sonst
# dasselbe wie Strg+q, damit die Handbewegung ueberall passt.
bindsym Control+Shift+q [con_id="__focused__" class="^(?!vitals-dashboard$).*$"] kill

# start dmenu (a program launcher)
# Bleibt bewusst die Liste mit "run" (nackte Binaernamen ohne Icon) -- im
# Raster auf Super+Space waere das sinnlos, in der Liste ist es nuetzlich.
# Kommando in "..." setzen: i3 wuerde das Komma in drun,run sonst als Befehlstrenner lesen
bindsym $mod+d exec --no-startup-id "rofi -show combi -modes combi -combi-modes drun,run"
# dmenu als Rueckfalloption
bindsym $mod+Shift+d exec --no-startup-id dmenu_run -nb "#1c1c1c" -nf "#d0d0d0" -sb "#87afdf" -sf "#1c1c1c"
# A more modern dmenu replacement is rofi:
# bindcode $mod+40 exec "rofi -modi drun,run -show drun"
# There also is i3-dmenu-desktop which only displays applications shipping a
# .desktop file. It is a wrapper around dmenu, so you need that installed.
# bindcode $mod+40 exec --no-startup-id i3-dmenu-desktop

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
# $mod+l liegt jetzt auf der Bildschirmsperre (siehe Sitzungsmenue oben).
# Fokus nach oben: $mod+Up. Der vim-Reihe fehlt damit die Aufwaerts-Taste.
# bindsym $mod+l focus up
bindsym $mod+odiaeresis focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+odiaeresis move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation (war vorher $mod+v, dort liegt jetzt der
# Verlauf der Zwischenablage)
bindsym $mod+Shift+v split v

# Verlauf der Zwischenablage, wie Super+V unter Windows. Gefuellt wird er vom
# Dienst clipmenud (exec_always weiter oben).
bindsym $mod+v exec --no-startup-id ~/.local/bin/zwischenablage

# Die Browser haben bewusst keine eigene Taste: Chrome startet ohnehin per
# Autostart auf Arbeitsflaeche 1, alles Weitere geht ueber rofi.
# $mod+f und $mod+b sind damit frei.

# enter fullscreen mode for the focused container (liegt auf Shift, weil
# $mod+f frueher Firefox startete)
bindsym $mod+Shift+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

# Dateimanager: PCManFM auf Mod+e, als frei bewegliches Fenster.
# Ohne --desktop, sonst legt es ein eigenes Vollbild-Fenster ueber das
# Root-Window und verdeckt das feh-Wallpaper.
bindsym $mod+e exec --no-startup-id pcmanfm

# PCManFM immer schwebend statt gekachelt, mittig und in fester Groesse.
# Die Kommas trennen hier bewusst drei i3-Befehle -- anders als in exec-Zeilen,
# wo ein Komma im Kommando in Anfuehrungszeichen muss.
for_window [class="Pcmanfm"] floating enable, resize set 1000 750, move position center

# Entwicklungsumgebung: VS Code auf Mod+c, installiert als Flatpak.
#
# floating disable steht hier bewusst, obwohl Kacheln der Normalfall ist:
# VS Code meldet sein Fenster beim ersten Start mit einer eigenen Wunsch-
# groesse an, und der Willkommensbildschirm kann als Dialog durchgehen --
# beides laesst i3 sonst gelegentlich ein schwebendes Fenster stehen.
# Die Regel zwingt jedes Code-Fenster ins normale Tiling.
#
# Die Klasse ist klein geschrieben ("code", nicht "Code"), so meldet der
# Flatpak-Build sein Fenster an. i3 vergleicht mit einem regulaeren Ausdruck
# und achtet dabei auf Gross- und Kleinschreibung -- (?i) macht die Regel
# unabhaengig davon, falls ein spaeterer Build das anders handhabt.
bindsym $mod+c exec --no-startup-id flatpak run com.visualstudio.code
for_window [class="(?i)^code$"] floating disable

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
# Fokus zwischen Tiling und Floating (war vorher $mod+space, dort liegt jetzt rofi)
bindsym $mod+Control+space focus mode_toggle

# rofi-Programmstarter als Raster (App-Drawer, wie am Handy).
# Eigene Themedatei, damit die dmenu-Skripte weiter als Liste erscheinen --
# die erben config.rasi, das Raster steht nur in raster.rasi.
# -drun-display-format {name}: ohne das schreibt rofi den .desktop-Kommentar
# mit ins Kaestchen ("Google Chrome (Web Browser)"), was im Raster nur den
# Namen abschneidet. Die Klammern muss i3 nicht schuetzen, ein Komma waere
# dagegen ein Befehlstrenner -- deshalb steht das Kommando trotzdem in "".
bindsym $mod+space exec --no-startup-id "rofi -show drun -drun-display-format {name} -theme ~/.config/rofi/raster.rasi"

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 exec --no-startup-id ws-swipe number 1
bindsym $mod+2 exec --no-startup-id ws-swipe number 2
bindsym $mod+3 exec --no-startup-id ws-swipe number 3
bindsym $mod+4 exec --no-startup-id ws-swipe number 4
bindsym $mod+5 exec --no-startup-id ws-swipe number 5
bindsym $mod+6 exec --no-startup-id ws-swipe number 6
bindsym $mod+7 exec --no-startup-id ws-swipe number 7
bindsym $mod+8 exec --no-startup-id ws-swipe number 8
bindsym $mod+9 exec --no-startup-id ws-swipe number 9
bindsym $mod+0 exec --no-startup-id ws-swipe number 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# Abmelden: fuehrt auf dasselbe Menue wie F12. Die Kachel laeuft sofort los,
# eine Rueckfrage gibt es dort nicht mehr -- rofi braucht zum Aktivieren
# ohnehin schon einen Doppelklick.
# Vorher stand hier der i3-nagbar -- der konnte nur abmelden und sah nicht aus
# wie der Rest.
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/i3-sitzung

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym odiaeresis resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# ---- Design: Monochrom-Grau (Chrome), keine Borders, alles eckig ----
# Fenster stossen direkt aneinander: kein Rahmen, keine Trennlinie, kein Gap.
default_border none
default_floating_border none
hide_edge_borders both

# ---- Titelleiste nur fuer Terminals mit eigenem Titel (= Claude-Sitzungen) ----
# Ausgangspunkt: laufen mehrere Claude-Sitzungen nebeneinander auf einer
# Flaeche, sehen sie alle gleich aus -- worum es in welcher geht, steht nur
# weiter oben im Verlauf.  Claude Code setzt aber den Fenstertitel auf das
# Thema der Sitzung ("◐ Lockscreen Fingerprint-Symbol Platzierung"), mit einem
# Spinner davor, der zwischen ◐ und ◑ wechselt, solange es arbeitet.
#
# Erkannt wird NICHT der Spinner, sondern "Titel ist nicht mehr der
# Alacritty-Standardtitel": die Shell hier setzt gar keinen Titel, ein
# abweichender Titel kommt also immer von einem Programm, das etwas zu sagen
# hat (claude, vim, ssh).  Das haelt auch dann, wenn Claude sein
# Spinner-Zeichen mal aendert.
#
# i3 wertet title-Kriterien bei JEDER Titelaenderung neu aus -- die Leiste
# erscheint also, sobald claude startet, und die zweite Regel nimmt sie wieder
# weg, sobald der Titel auf "Alacritty" zurueckfaellt.  "border normal 0"
# heisst: Titelleiste ja, Rahmen an den Seiten nein.
#
# Das Autostart-Terminal auf Flaeche 2 muss mitgemeint sein: es laeuft unter
# der eigenen Klasse "autostart-term" (die braucht das "assign" weiter oben)
# und fiel darum durch die reine Alacritty-Regel hindurch -- genau dort laufen
# aber Claude-Sitzungen.  Die uebrigen Terminals (remote-term, vitals-dashboard)
# bleiben bewusst draussen: dort steht immer dasselbe drin.
# Titel mittig -- linksbuendig klebt er sonst in der Ecke ueber dem Text,
# in der Mitte liest er sich wie eine Ueberschrift der Sitzung.
title_align center

for_window [class="^(Alacritty|autostart-term)$" title="^(?!Alacritty$).*$"] border normal 0
for_window [class="^(Alacritty|autostart-term)$" title="^Alacritty$"] border none

# Farben greifen nur noch dort, wo i3 doch Flaechen zeichnet
# (z. B. Titelleisten im stacking/tabbed-Layout und an den Claude-Fenstern).
#
# Die Titelleiste soll nicht als Balken auffallen, sondern wie ein Stueck
# Terminal aussehen: Hintergrund darum exakt der Terminal-Hintergrund
# #1e1e1e aus alacritty.toml, nicht das hellere #2a2a2a von frueher.
# Fokussiert/unfokussiert unterscheidet nur noch die Schriftfarbe.
# Nicht #1e1e1e, sondern #1d1d1d: das Terminal ist per opacity 0.95 minimal
# durchsichtig, das dunkle Wallpaper zieht seinen Hintergrund dadurch eine
# Stufe herunter.  Am Schirm nachgemessen (import + magick histogram): Terminal
# #1d1d1d, Titelleiste mit #1e1e1e #1e1e1e -- mit #1d1d1d treffen sie sich exakt.
# class                 border  backgr. text    indicator child_border
client.focused          #1d1d1d #1d1d1d #e8e8e8 #1d1d1d   #1d1d1d
client.focused_inactive #1d1d1d #1d1d1d #6a6a6a #1d1d1d   #1d1d1d
client.unfocused        #1d1d1d #1d1d1d #6a6a6a #1d1d1d   #1d1d1d
client.urgent           #fb4934 #161616 #fb4934 #161616   #fb4934
client.placeholder      #161616 #161616 #9a9a9a #161616   #161616
client.background       #1e1e1e

# Compositor fuer Terminal-Transparenz (nur wirksam, wenn picom installiert ist)
exec --no-startup-id picom -b

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        position top
        # Nicht i3status direkt, sondern der Wrapper ~/.local/bin/i3status-melder:
        # er reicht i3status durch und haengt die Glocke fuer den
        # Benachrichtigungs-Verlauf an (Linksklick oeffnet ihn, Rechtsklick
        # leert ihn). Klickbare Bloecke kann i3status selbst nicht liefern.
        #
        # Der Wrapper legt auch die Reihenfolge rechts aussen fest -- nicht
        # "order" in ~/.config/i3status/config:
        #   ... Ton | Datum+Uhr | Glocke | Akku
        #
        # Derselbe Wrapper fasst CPU, Temperatur, RAM und Platte zu einem
        # Block ganz links zusammen -- sichtbar ist nur das CPU-Icon mit dem
        # Prozentwert, ein Linksklick wechselt auf Arbeitsflaeche 4 zum
        # Vitals-Dashboard. Schlaegt einer der vier Werte an, steht er wieder
        # in der Leiste.
        status_command ~/.local/bin/i3status-melder
        # Pango-Syntax: erst die Familienliste (Komma-getrennt), die Groesse
        # ganz am Ende gilt fuer alle. Groesse 11 statt 10, damit die Icons
        # zur hoeheren Leiste passen.
        font pango:Red Hat Mono, Symbols Nerd Font Mono 11

        # Leistenhoehe 30px: i3 kennt kein "height", die Hoehe ergibt sich aus
        # Schrifthoehe + padding oben/unten (i3 >= 4.22, ersetzt i3-gaps-"height").
        padding 2px

        # Etwas Mindestbreite, damit die Arbeitsflaechen-Knoepfe nicht kleben
        workspace_min_width 30

        # ---- Design: Statusleiste monochrom, Akzente kommen aus i3status ----
        # Aktiver Workspace: helles Grau auf leicht hellerer Flaeche (kein Orange).
        colors {
                background #161616
                statusline #e8e8e8
                separator  #3a3a3a

                #                  border  backgr. text
                focused_workspace  #2a2a2a #2a2a2a #e8e8e8
                active_workspace   #161616 #161616 #9a9a9a
                inactive_workspace #161616 #161616 #555555
                urgent_workspace   #161616 #161616 #fb4934
                binding_mode       #2a2a2a #2a2a2a #e8e8e8
        }
}
