#!/bin/sh
# akku-wache -- warnt, wenn der Akku zur Neige geht oder die CPU zu heiss wird
#
# Laeuft als Hintergrundprozess aus der i3-Config heraus. Braucht Polling:
# acpid ist hier gar nicht eingeschaltet (installiert ja, /var/service/acpid
# nein) und wuesste ohnehin nichts von Schwellwerten -- er meldet nur Ein- und
# Ausstecken, nicht "noch 15 Prozent". Genau das Ein- und Ausstecken vertont
# ~/.local/bin/netz-ton, das bleibt getrennt: dort quittiert der Ton eine
# Handlung, hier warnt er. Eigene Toene braucht es hier trotzdem, weil eine
# stumme Meldung genau dann untergeht, wenn es darauf ankommt -- im
# Vollbild-Video, auf der zweiten Arbeitsflaeche, beim Blick aufs Handy.
#
# Hysterese ueber Zustandsmerker: eine Stufe meldet sich beim Eintreten und
# danach nur noch im eigenen Wiederholtakt -- nicht bei jedem Schleifen-
# durchlauf. Ohne das kaeme alle 60 Sekunden dieselbe Warnung; ganz ohne
# Wiederholung dagegen verpasst man sie einmal und nie wieder.
#
# Kritische Meldungen haben in der dunstrc timeout 0, bleiben also stehen,
# bis sie jemand wegklickt ODER dieses Skript sie schliesst. Genau darum
# merken wir uns die Notification-ID (dunstify -p) in einer Datei: sobald
# der Grund weg ist -- Netzteil dran, Akku wieder ueber der Schwelle, CPU
# abgekuehlt -- wird die Meldung aktiv geschlossen. Und weil i3 dieses
# Skript bei jedem Reload per exec_always neu startet, raeumt der Start die
# Meldungen des Vorgaengers weg; sonst haengt eine alte "Akku fast leer"-
# Warnung mit laengst falschem Prozentwert fuer immer am Bildschirm.
#
# Der Akku heisst auf diesem Geraet BAT1, nicht BAT0.

AKKU=/sys/class/power_supply/BAT1
NETZ=/sys/class/power_supply/ACAD
TEMP=/sys/class/hwmon/hwmon4/temp1_input     # Package-Temperatur, wie i3status

INTERVALL=60       # Sekunden im Normalbetrieb
INTERVALL_WARN=10  # Sekunden, solange eine Warnung offen steht: dann soll das
                   # Anstecken schnell quittiert werden, nicht erst nach einer
                   # vollen Minute mit falschem Wert auf dem Schirm.
WARN=20            # Prozent: erste Warnung
KRITISCH=10        # Prozent: dringende Warnung

# Beide Stufen melden sich erneut, solange der Zustand anhaelt. Ohne das
# verschwindet die 20-Prozent-Meldung nach dem dunst-Timeout und kommt durch
# die Hysterese nie wieder -- einmal weggeschaut und die Warnung ist weg.
WARN_WIEDERHOLUNG=600       # Sekunden: 20-Prozent-Meldung, ruhig alle 10 Minuten
KRITISCH_WIEDERHOLUNG=120   # Sekunden: 10-Prozent-Meldung, deutlich draengender
TEMP_WARN=90       # Grad Celsius

LAUTSTAERKE=1.0    # Faktor auf die eingestellte Lautstaerke

TONDIR="${XDG_DATA_HOME:-$HOME/.local/share}/akku-wache"
TON_WARNUNG="$TONDIR/warnung.wav"
TON_ALARM="$TONDIR/alarm.wav"

LAUFDIR="${XDG_RUNTIME_DIR:-/tmp}"
PIDDATEI="$LAUFDIR/akku-wache.pid"
IDDATEI="$LAUFDIR/akku-wache.ids"    # zwei Zeilen: Akku-ID, Temperatur-ID

# Nur eine Instanz: i3 startet dieses Skript per exec_always bei jedem
# Neuladen erneut. Ein "pkill -f akku-wache" hier wuerde die eigene Shell
# mit erwischen, darum der Umweg ueber eine PID-Datei.
if [ -r "$PIDDATEI" ]; then
    alt=$(cat "$PIDDATEI")
    [ -n "$alt" ] && [ "$alt" != "$$" ] && kill "$alt" 2>/dev/null
fi
echo $$ > "$PIDDATEI"

# Offene Meldungen des Vorgaengers wegraeumen. Steht der Grund noch an,
# meldet der erste Schleifendurchlauf ihn gleich wieder -- diesmal mit
# aktuellen Zahlen.
if [ -r "$IDDATEI" ]; then
    while read -r verwaiste; do
        [ -n "$verwaiste" ] && [ "$verwaiste" != 0 ] && dunstify -C "$verwaiste" 2>/dev/null
    done < "$IDDATEI"
fi

id_akku=0
id_temp=0

ids_sichern() {
    printf '%s\n%s\n' "$id_akku" "$id_temp" > "$IDDATEI"
}
ids_sichern

# ---- Toene ----------------------------------------------------------------
# Gleiches Verfahren wie in netz-ton, inklusive der halben Sekunde Stille am
# Anfang: der Lautsprecher-Sink steht im Leerlauf auf SUSPENDED, und PipeWire
# weckt das ALSA-Geraet erst auf -- ein kurzer Klang waere vorbei, bevor der
# Codec ueberhaupt Ton macht.
#
# Die beiden Toene sind absichtlich weit auseinander: die Warnung ist ein
# freundliches Doppel-Blip in mittlerer Lage, der Alarm sind drei harte hohe
# Stoesse mit tiefem Abschluss. Man soll im Nebenzimmer hoeren, welche der
# beiden Stufen gerade dran ist, ohne hinzusehen.
toene_erzeugen() {
    mkdir -p "$TONDIR" || return 1
    python3 - "$TONDIR" <<'PYTHON_ENDE'
import math, struct, sys, wave

RATE = 24000

def ton(pfad, noten):
    daten = bytearray()
    daten += b'\x00\x00' * int(RATE * 0.45)         # Vorlauf gegen den Suspend
    for frequenz, dauer in noten:
        n = int(RATE * dauer)
        for i in range(n):
            # Kurze Rampen an beiden Enden, sonst knackt es am Sprung.
            rampe = min(1.0, i / (RATE * 0.008), (n - i) / (RATE * 0.008))
            wert = 0.5 * rampe * math.sin(2 * math.pi * frequenz * i / RATE)
            daten += struct.pack('<h', int(wert * 32767))
    daten += b'\x00\x00' * int(RATE * 0.05)
    with wave.open(pfad, 'wb') as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(bytes(daten))

ziel = sys.argv[1]
# Frequenz 0 ergibt sin(0) = 0, also Stille -- so entstehen die Pausen.
ton(ziel + '/warnung.wav', [(698.5, 0.12), (0.0, 0.06), (698.5, 0.12)])
ton(ziel + '/alarm.wav',   [(1046.5, 0.09), (0.0, 0.05),
                            (1046.5, 0.09), (0.0, 0.05),
                            (1046.5, 0.09), (0.0, 0.05),
                            (523.25, 0.40)])
PYTHON_ENDE
}

if [ ! -r "$TON_WARNUNG" ] || [ ! -r "$TON_ALARM" ]; then
    toene_erzeugen || echo "akku-wache: Toene liessen sich nicht erzeugen" >&2
fi

spiele() {  # spiele <datei>
    # Im Hintergrund, damit der naechste Takt nicht auf das Ende des Tons
    # wartet. Ist der Ausgang stummgeschaltet, spielt es lautlos ins Leere.
    [ -r "$1" ] && pw-play --volume "$LAUTSTAERKE" "$1" >/dev/null 2>&1 &
}

# Das Icon ist ein Name aus dem Icon-Theme (Papirus-Light, sonst Papirus),
# frueher stand hier ein Nerd-Font-Zeichen im Titel.
melde() {   # melde <tag> <dringlichkeit> <icon-name> <titel> <text> <alte-id>
    dunstify -a akku-wache -u "$2" -p -r "${6:-0}" -i "$3" \
             -h "string:x-dunst-stack-tag:$1" \
             "$4" "$5"
}

schliesse() {   # schliesse <id>
    [ -n "$1" ] && [ "$1" != 0 ] && dunstify -C "$1" 2>/dev/null
}

aufraeumen() {
    # Nur aufraeumen, wenn kein Nachfolger uebernommen hat. Beim i3-Reload
    # killt die neue Instanz die alte -- deren Trap laeuft dann verzoegert
    # (dash arbeitet Signale erst nach dem laufenden "sleep" ab) und wuerde
    # sonst die Meldungen und die ID-Datei des Nachfolgers wegputzen.
    if [ "$(cat "$PIDDATEI" 2>/dev/null)" = "$$" ]; then
        schliesse "$id_akku"
        schliesse "$id_temp"
        rm -f "$IDDATEI"
    fi
    exit 0
}
trap aufraeumen INT TERM

[ -r "$AKKU/capacity" ] || { echo "akku-wache: $AKKU nicht lesbar" >&2; exit 1; }

stufe_akku=voll        # voll | warn | kritisch
seit_meldung=0         # Sekunden seit der letzten Akkumeldung
temp_heiss=nein

while :; do
    ladung=$(cat "$AKKU/capacity" 2>/dev/null)
    am_netz=$(cat "$NETZ/online"  2>/dev/null)

    if [ "$am_netz" = "1" ]; then
        # Am Netz: Warnungen zuruecknehmen, damit sie beim naechsten
        # Akkubetrieb wieder greifen.
        if [ "$stufe_akku" != voll ]; then
            # Nur wegraeumen, nicht selbst quittieren: das "Netzteil
            # angeschlossen" meldet netz-ton, und zwar sofort statt erst beim
            # naechsten Takt. Zwei Meldungen dafuer waeren eine zu viel.
            schliesse "$id_akku"
            id_akku=0
            stufe_akku=voll
            seit_meldung=0
            ids_sichern
        fi
    else
        if [ "$ladung" -le "$KRITISCH" ]; then
            # Meldet beim Eintreten und danach alle KRITISCH_WIEDERHOLUNG
            # Sekunden erneut -- mit dem dann aktuellen Prozentwert und jedes
            # Mal mit Ton. Wegklicken beendet also nur den Anblick, nicht die
            # Warnung; das ist bei zehn Prozent genau richtig.
            if [ "$stufe_akku" != kritisch ] || \
               [ "$seit_meldung" -ge "$KRITISCH_WIEDERHOLUNG" ]; then
                id_akku=$(melde akku critical battery-010 "Akku kritisch -- noch ${ladung}%" \
                                "Jetzt anstecken. Sonst schaltet das Geraet in Kuerze ab." "$id_akku")
                spiele "$TON_ALARM"
                stufe_akku=kritisch
                seit_meldung=0
                ids_sichern
            fi
        elif [ "$ladung" -le "$WARN" ]; then
            # Kein Sonderfall fuer den Weg von kritisch zurueck nach warn:
            # im Akkubetrieb geht der Wert nur nach unten, und wackelt er doch
            # einmal ein Prozent nach oben, bleibt lieber die kritische
            # Meldung stehen, als dass sie zur milden herabgestuft wird.
            if [ "$stufe_akku" = voll ] || \
               { [ "$stufe_akku" = warn ] && [ "$seit_meldung" -ge "$WARN_WIEDERHOLUNG" ]; }; then
                id_akku=$(melde akku normal battery-020 "Akku wird knapp" \
                                "Noch ${ladung}%." "$id_akku")
                spiele "$TON_WARNUNG"
                stufe_akku=warn
                seit_meldung=0
                ids_sichern
            fi
        elif [ "$ladung" -gt "$WARN" ] && [ "$stufe_akku" != voll ]; then
            schliesse "$id_akku"
            id_akku=0
            stufe_akku=voll
            ids_sichern
        fi
    fi

    if [ -r "$TEMP" ]; then
        grad=$(( $(cat "$TEMP") / 1000 ))
        if [ "$grad" -ge "$TEMP_WARN" ] && [ "$temp_heiss" = nein ]; then
            id_temp=$(melde temp critical indicator-sensors-cpu "CPU sehr heiss" "${grad} Grad." "$id_temp")
            temp_heiss=ja
            ids_sichern
        elif [ "$grad" -lt $(( TEMP_WARN - 8 )) ] && [ "$temp_heiss" = ja ]; then
            # 8 Grad Abstand nach unten, sonst flattert die Meldung an der
            # Schwelle hin und her.
            schliesse "$id_temp"
            id_temp=0
            temp_heiss=nein
            ids_sichern
        fi
    fi

    if [ "$stufe_akku" != voll ] || [ "$temp_heiss" = ja ]; then
        schlaf=$INTERVALL_WARN
    else
        schlaf=$INTERVALL
    fi
    # Der Zaehler laeuft ueber die Schlafdauer, nicht ueber die Zahl der
    # Durchlaeufe: der Takt wechselt ja zwischen 10 und 60 Sekunden.
    seit_meldung=$(( seit_meldung + schlaf ))
    sleep "$schlaf"
done
