#!/usr/bin/env python3
"""Dashboard-Pane "Uhr": deutsches Datum oben, darunter die Uhrzeit gross.

Warum nicht mehr tty-clock:
tty-clock kann das Datum ausschliesslich UNTER den Ziffern zeichnen, und
zwar an einer Stelle, die es aus der Ziffernbox ableitet -- ohne "-x" faellt
es in die letzte Ziffernzeile hinein, mit "-x" kommen zwei Kaesten dazu, die
im Dashboard nichts zu suchen haben. Dazu kommt, dass tty-clock die
Datumszeile nach jeder Groessenaenderung des Terminals gar nicht mehr
zeichnet -- und genau eine solche Aenderung macht zellij beim Start, weil es
das Pane erst in Vorgabegroesse anlegt und dann auf die Layoutgroesse zieht.
Das kostete eine Hilfskonstruktion, die die Panegroesse pollte und tty-clock
neu startete.

Die paar Zeilen hier ersetzen beides: die Groesse wird bei jedem Neuzeichnen
frisch abgefragt, ein Resize ist damit kein Sonderfall mehr.

Die Ziffern sind Siebensegment-Muster, 6 Zellen breit und 5 hoch, gesetzt
aus Leerzeichen mit Hintergrundfarbe 7 -- dieselbe Darstellung, die
tty-clock mit "-C 7" benutzte, damit sich das Bild nicht aendert.
"""

import locale
import os
import signal
import sys
import time

# Wochentag und Monat auf Deutsch. Anders als tty-clock (das nie
# setlocale() aufruft und darum immer "Wednesday" schrieb) fragt Python die
# Locale hier wirklich ab.
for kandidat in ("de_DE.utf8", "de_DE.UTF-8", "de_DE"):
    try:
        locale.setlocale(locale.LC_TIME, kandidat)
        break
    except locale.Error:
        continue

ZIFFERN = {
    "0": ("111111", "110011", "110011", "110011", "111111"),
    "1": ("000011", "000011", "000011", "000011", "000011"),
    "2": ("111111", "000011", "111111", "110000", "111111"),
    "3": ("111111", "000011", "111111", "000011", "111111"),
    "4": ("110011", "110011", "111111", "000011", "000011"),
    "5": ("111111", "110000", "111111", "000011", "111111"),
    "6": ("111111", "110000", "111111", "110011", "111111"),
    "7": ("111111", "000011", "000011", "000011", "000011"),
    "8": ("111111", "110011", "111111", "110011", "111111"),
    "9": ("111111", "110011", "111111", "000011", "111111"),
    ":": ("00", "11", "00", "11", "00"),
}

HOCH = 5
AN = "\033[47m"       # Hintergrundfarbe 7, wie tty-clock -C 7
AUS = "\033[0m"


def zeilen(text):
    """Die fuenf Bildzeilen fuer eine Zeichenkette wie "22:08"."""
    muster = ["" for _ in range(HOCH)]
    for i, zeichen in enumerate(text):
        glyph = ZIFFERN.get(zeichen)
        if glyph is None:
            continue
        if i:
            # Um den Doppelpunkt zwei Spalten, sonst eine -- er ist nur
            # zwei Zellen breit und klebte sonst an der Ziffer davor.
            abstand = 2 if ":" in (zeichen, text[i - 1]) else 1
            for z in range(HOCH):
                muster[z] += "0" * abstand
        for z in range(HOCH):
            muster[z] += glyph[z]
    return muster


def faerben(muster_zeile):
    """Aus "0011" wird Text mit Hintergrundfarbe -- gleiche Zellen gebuendelt,
    damit pro Zeile ein paar Escapes reichen statt einer pro Zelle."""
    ausgabe = []
    i = 0
    while i < len(muster_zeile):
        j = i
        while j < len(muster_zeile) and muster_zeile[j] == muster_zeile[i]:
            j += 1
        block = " " * (j - i)
        ausgabe.append(AN + block + AUS if muster_zeile[i] == "1" else block)
        i = j
    return "".join(ausgabe)


def zeichnen(spalten, reihen, datum, uhrzeit):
    """Das ganze Pane Zeile fuer Zeile neu setzen, ohne es zu loeschen.

    Kein "\033[2J": zellij schiebt beim Bildschirmloeschen die bisherigen
    Zeilen in den Rueckscroll und schreibt dann "SCROLL: 0/9" in den
    Panetitel -- bei jedem Minutenwechsel ein Stueck mehr. Auch "\033[3J"
    raeumt das nicht wieder weg. Stattdessen wird jede Zeile ueber ihre
    volle Breite ueberschrieben, dann bleibt nichts stehen und nichts
    wandert nach oben. Positioniert wird absolut mit "\033[Zeile;SpalteH".
    """
    bild = zeilen(uhrzeit)
    breite = len(bild[0]) if bild else 0

    # Datum, Leerzeile, Ziffern -- als ein Block senkrecht zentriert.
    oben = max(0, (reihen - (HOCH + 2)) // 2)
    datumzeile = oben + 1
    ziffernzeile = oben + 3

    einzug_datum = max(0, (spalten - len(datum)) // 2)
    einzug_bild = max(0, (spalten - breite) // 2)

    teile = []
    for r in range(1, reihen + 1):
        if r == datumzeile:
            inhalt = (" " * einzug_datum + datum).ljust(spalten)[:spalten]
        elif ziffernzeile <= r < ziffernzeile + HOCH:
            muster = ("0" * einzug_bild + bild[r - ziffernzeile]).ljust(spalten, "0")[:spalten]
            inhalt = faerben(muster)
        else:
            inhalt = " " * spalten
        teile.append("\033[%d;1H%s" % (r, inhalt))
    teile.append("\033[H")
    sys.stdout.write("".join(teile))
    sys.stdout.flush()


def aufraeumen(*_):
    sys.stdout.write("\033[?25h\033[0m\n")
    sys.stdout.flush()
    sys.exit(0)


def main():
    signal.signal(signal.SIGTERM, aufraeumen)
    signal.signal(signal.SIGINT, aufraeumen)
    sys.stdout.write("\033[?25l")          # Cursor weg, er blinkt sonst mitten im Bild

    zuletzt = None
    while True:
        try:
            groesse = os.get_terminal_size()
            spalten, reihen = groesse.columns, groesse.lines
        except OSError:
            spalten, reihen = 80, 24

        jetzt = time.localtime()
        datum = time.strftime("%A, %d. %B %Y", jetzt)
        uhrzeit = time.strftime("%H:%M", jetzt)

        # Nur neu zeichnen, wenn sich wirklich etwas geaendert hat -- also
        # zur vollen Minute oder nach einer Groessenaenderung des Panes.
        stand = (spalten, reihen, datum, uhrzeit)
        if stand != zuletzt:
            zeichnen(spalten, reihen, datum, uhrzeit)
            zuletzt = stand

        time.sleep(1)


if __name__ == "__main__":
    main()
