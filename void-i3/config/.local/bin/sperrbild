#!/bin/sh
# sperrbild [finger|nochmal|aufwachen]  -- baut den Hintergrund des
# Sperrbildschirms und gibt den Pfad des fertigen PNG aus.
#
# xsecurelock zeichnet selbst nur eine Farbflaeche; alles Bildliche kommt vom
# Saver-Modul (/usr/libexec/xsecurelock/saver_sperrbild), und das zeigt genau
# dieses PNG an. Der Text steht also im Bild, nicht im Programm -- deshalb
# gibt es drei Zustaende:
#
#   finger   -- Ausgangsbild: Fingerabdruck-Symbol und "Unlock with
#               fingerprint"
#   nochmal  -- nach einem misslungenen Fingerversuch: "Try again" in Rot.
#               Das Passwortfeld darunter zeichnet xsecurelock selbst.
#   aufwachen -- der Rechner kommt gerade aus der Bereitschaft: "Waking up"
#               und KEIN Symbol, denn an dessen Stelle laesst sperrsaver den
#               Ladekreis laufen.
#
# Gebaut wird nur, wenn noetig: liegt das Bild schon passend zu Wallpaper und
# Aufloesung im Cache, wird es wiederverwendet. Das Sperren soll nicht auf
# ImageMagick warten.

zustand="${1:-finger}"

SYMBOLSCHRIFT=/usr/share/fonts/NerdFonts/ttf/symbols/SymbolsNerdFontMono-Regular.ttf
TEXTSCHRIFT=Red-Hat-Mono-Regular
TEXTSCHRIFT_KRAEFTIG=Red-Hat-Mono-Medium

# Farben wie in ~/.config/rofi/config.rasi
HELL='#e8e8e8'
GEDIMMT='#9a9a9a'
WARNUNG='#fb4934'

# Fingerabdruck: U+F0237 aus der Nerd Font. Die Glyphe steht hier als
# Escape-Sequenz und nicht als Zeichen, damit die Datei reiner ASCII bleibt --
# ein unsichtbar kaputtes Symbol waere sonst kaum zu finden.
GLYPHE=$(printf '\363\260\210\267')

cachedir="$HOME/.cache/sperrbild"
mkdir -p "$cachedir"

# ---- Aufloesung des laufenden X-Servers
# Ueber xdotool, nicht ueber xdpyinfo: das gibt es auf diesem System nicht,
# und sein Fehlschlag waere still -- die Groesse fiele wortlos auf den
# Standardwert zurueck und das Bild passte auf einem anderen Schirm nicht.
masse=$(xdotool getdisplaygeometry 2>/dev/null)
breite=$(printf '%s\n' "$masse" | cut -d' ' -f1)
hoehe=$( printf '%s\n' "$masse" | cut -d' ' -f2)
case "$breite$hoehe" in
    *[!0-9]*|"") breite=1920; hoehe=1080 ;;
esac

# ---- Wallpaper: dieselbe Quelle, aus der auch i3 beim Start liest
wallpaper=$(sed -n "s/.*feh .*'\(.*\)'.*/\1/p" "$HOME/.fehbg" 2>/dev/null | tail -n1)
if [ ! -f "$wallpaper" ]; then
    wallpaper=$(find "$HOME/Bilder/Wallpapers" -maxdepth 1 -type f \
                \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) 2>/dev/null |
                sort | head -n1)
fi

ziel="$cachedir/$zustand-$breite-$hoehe.png"

# Frisch genug? Dann nichts tun. -nt ist in dash vorhanden.
if [ -f "$ziel" ] && [ -n "$wallpaper" ] && [ ! "$wallpaper" -nt "$ziel" ] &&
   [ ! "$0" -nt "$ziel" ]; then
    echo "$ziel"
    exit 0
fi

benutzer=$(id -un)
rechner=$(uname -n)

# Im Zustand "aufwachen" bleibt der Symbolplatz leer: dort zeichnet
# sperrsaver den laufenden Ladekreis, und beides uebereinander waere Matsch.
# Die beiden -annotate laufen trotzdem mit -- mit leerem Text setzen sie
# nichts, und der Aufruf unten bleibt fuer alle drei Zustaende derselbe.
case "$zustand" in
    nochmal)   meldung="Try again";               farbe="$WARNUNG"; symbol="$GLYPHE" ;;
    aufwachen) meldung="Waking up";               farbe="$GEDIMMT"; symbol=""        ;;
    *)         meldung="Unlock with fingerprint"; farbe="$HELL";    symbol="$GLYPHE" ;;
esac

# ---- Aussehen
#
# Die Schrift steht ohne Kasten direkt auf dem Wallpaper. Damit sie dort
# lesbar bleibt, wird das Bild weich gezeichnet und deutlich abgedunkelt, und
# jede Zeile bekommt zusaetzlich einen dunklen Schatten. Das ersetzt die
# Flaeche, die hier frueher stand -- ein Rechteck in #1e1e1e mit grauem
# Rahmen. Es hat den Text sicher lesbar gemacht, lag aber als harte Kante
# mitten im Bild.
#
# Der Weichzeichner laeuft ueber Verkleinern und wieder Vergroessern statt
# ueber -blur in voller Groesse: -blur mit einem Radius, der bei 1080 Zeilen
# ueberhaupt auffiele, braucht mehrere Sekunden. Das Ergebnis ist hier nicht
# zu unterscheiden, es soll ja nur Unschaerfe sein.
ABDUNKLUNG=45
SCHATTEN='#000000'

# ---- Senkrechte Anordnung
#
# Die Anmeldemaske von xsecurelock sitzt fest in der Bildmitte und laesst
# sich nicht verschieben -- auth_x11 kennt keine Variable dafuer (nachgesehen
# mit "strings /usr/libexec/xsecurelock/auth_x11 | grep XSECURELOCK"). Auf
# einem 1920x1080-Testschirm nachgemessen (Differenz zweier Aufnahmen, mit
# und ohne Maske) liegt sie bei y 480..569, also 44,4 % bis 52,7 %.
#
# Daraus folgt die Reihenfolge hier: Symbol und Meldung dicht UEBER der
# Maske, Name und Rechnername DARUNTER. Alles zusammen -- Symbol, Hinweis,
# Passwortfeld, Name -- liegt damit als eine Spalte um die Bildmitte. Stuende
# der Name wie ueblich oben, muesste die ganze Gruppe ueber die Maske passen
# und saesse sichtbar zu hoch im oberen Drittel.
#
# Zwei Dinge, ueber die man beim Nachstellen stolpert:
#
# Erstens ist die y-Angabe von -annotate bei -gravity north die OBERKANTE der
# Tinte, nicht die Grundlinie. Nachgemessen mit -trim: "-pointsize 130
# -annotate +0+200" auf leerer Flaeche liefert Tinte ab genau y 200.
#
# Zweitens fuellt die Fingerabdruck-Glyphe ihr Geviert fast ganz aus -- 130
# Punkt sind hier rund 131 Pixel hoch, viel mehr als bei den 36 Punkt des
# Namens (32 Pixel). Wer das verwechselt, setzt das Symbol in die Maske.
#
# Unterkanten bei 1080 Zeilen: Symbol 431, Meldung 470 -- dann die Maske
# 480..569 -- danach Name 632, Rechner 661.
gr_name=$((   hoehe * 100 / 3000 ))   # 1080 -> 36
gr_rechner=$((hoehe * 100 / 4500 ))   # 1080 -> 24
gr_symbol=$(( hoehe * 100 / 830  ))   # 1080 -> 130
gr_meldung=$((hoehe * 100 / 4000 ))   # 1080 -> 27

y_symbol=$((  hoehe * 278  / 1000 ))
y_meldung=$(( hoehe * 412  / 1000 ))
y_name=$((    hoehe * 556  / 1000 ))
y_rechner=$(( hoehe * 597  / 1000 ))

# Versatz des Schattens, ebenfalls aus der Hoehe abgeleitet.
versatz=$(( hoehe / 540 ))            # 1080 -> 2
[ "$versatz" -lt 1 ] && versatz=1

y_symbol_s=$((  y_symbol  + versatz ))
y_meldung_s=$(( y_meldung + versatz ))
y_name_s=$((    y_name    + versatz ))
y_rechner_s=$(( y_rechner + versatz ))

if [ -n "$wallpaper" ] && [ -f "$wallpaper" ]; then
    klein_b=$(( breite / 8 ))
    klein_h=$(( hoehe  / 8 ))
    grundlage="$wallpaper -resize ${breite}x${hoehe}^ -gravity center -extent ${breite}x${hoehe}
               -resize ${klein_b}x${klein_h}! -blur 0x2 -resize ${breite}x${hoehe}!
               -fill black -colorize ${ABDUNKLUNG}%"
else
    # Kein Wallpaper gefunden: einfarbig wie der i3-Hintergrund.
    grundlage="-size ${breite}x${hoehe} xc:#161616"
fi

# Jede Zeile wird zweimal gesetzt: erst der Schatten, um den Versatz nach
# rechts unten geschoben, dann der Text darueber. Ohne ihn verschluckt ein
# heller Bildausschnitt die duennen Buchstaben der Red Hat Mono trotz
# Abdunklung.
#
# shellcheck disable=SC2086  -- $grundlage soll in Woerter zerfallen
magick $grundlage \
    -gravity north \
    -font "$SYMBOLSCHRIFT" -pointsize "$gr_symbol" \
        -fill "$SCHATTEN" -annotate +"$versatz"+"$y_symbol_s" "$symbol" \
        -fill "$farbe"    -annotate +0+"$y_symbol"            "$symbol" \
    -font "$TEXTSCHRIFT" -pointsize "$gr_meldung" \
        -fill "$SCHATTEN" -annotate +"$versatz"+"$y_meldung_s" "$meldung" \
        -fill "$farbe"    -annotate +0+"$y_meldung"            "$meldung" \
    -font "$TEXTSCHRIFT_KRAEFTIG" -pointsize "$gr_name" \
        -fill "$SCHATTEN" -annotate +"$versatz"+"$y_name_s" "$benutzer" \
        -fill "$HELL"     -annotate +0+"$y_name"            "$benutzer" \
    -font "$TEXTSCHRIFT" -pointsize "$gr_rechner" \
        -fill "$SCHATTEN" -annotate +"$versatz"+"$y_rechner_s" "$rechner" \
        -fill "$GEDIMMT"  -annotate +0+"$y_rechner"            "$rechner" \
    "$ziel" 2>/dev/null

echo "$ziel"
