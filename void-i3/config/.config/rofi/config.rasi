/* rofi - Monochrom-Grau (Chrome), Icons als einzige Farbtraeger.
   Konsequent eckig: border-radius ueberall explizit 0. */
configuration {
    terminal:   "alacritty";
    font:       "Red Hat Mono 11";
    show-icons:  true;
    icon-theme: "Papirus-Dark";
}

* {
    bg:      #1e1e1e;
    bg-sel:  #2a2a2a;
    line:    #6e6e6e;   /* Fensterrahmen; Trennlinien sind raus (B1/B2) */
    fg:      #e8e8e8;
    fg-dim:  #9a9a9a;
    urgent:  #fb4934;

    background-color: transparent;
    text-color:       @fg-dim;
    border-radius:    0px;
}

window {
    width:            34%;
    background-color: @bg;
    border:           2px;
    border-color:     @line;
    border-radius:    0px;
    padding:          0;
}

mainbox { children: [ inputbar, listview ]; }

inputbar {
    background-color: @bg;
    padding:          9px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt  { text-color: @fg-dim; }
entry   { text-color: @fg; placeholder: "Suchen..."; placeholder-color: @fg-dim; }

listview { lines: 10; scrollbar: false; padding: 4px 0px; border: 0; }

element          { padding: 6px 12px; spacing: 8px; children: [ element-icon, element-text ]; }
element-icon     { size: 1.3em; vertical-align: 0.5; }
element-text     { vertical-align: 0.5; text-color: inherit; }
/* Zustaende ausgeschrieben: rofis Standardthema faerbt "normal.normal" und
   "alternate.normal" beige (#fdf6e3) und streift damit die Liste. Ein blosses
   "element normal" ist weniger spezifisch und kommt dagegen nicht an. */
element normal.normal     { background-color: @bg;     text-color: @fg-dim; }
element alternate.normal  { background-color: @bg;     text-color: @fg-dim; }
element selected.normal   { background-color: @bg-sel; text-color: @fg;     }
element normal.urgent     { background-color: @bg;     text-color: @urgent; }
element alternate.urgent  { background-color: @bg;     text-color: @urgent; }
element selected.urgent   { background-color: @bg-sel; text-color: @urgent; }
element normal.active     { background-color: @bg;     text-color: @fg;     }
element alternate.active  { background-color: @bg;     text-color: @fg;     }
element selected.active   { background-color: @bg-sel; text-color: @fg;     }
