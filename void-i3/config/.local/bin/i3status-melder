AKKU = os.path.expanduser("~/.local/bin/akku")

# Zustand des Adapters, gefuellt von bt_abfragen(): None heisst "noch nichts
# gelesen", ein leeres dict heisst "kein Adapter da" -- dann faellt der Block weg.
bt = None
# Zielzustand waehrend des Umschaltens (True = soll an), sonst None. Damit
# zeigt der Block sofort "schaltet ...", statt bis zur naechsten Antwort von
# bluez auf dem alten Stand stehen zu bleiben.
bt_ziel = None
# Dasselbe fuers WLAN: True, solange nach dem Einschalten noch keine
# Verbindung steht.
wlan_verbindet = False
bt_gelesen = 0.0
bt_punkte = 0
bt_puls_laeuft = False
bt_uhr = None

# Tailscale-Block: haengt der Rechner im Tailnet, und ist die Gegenstelle da.
GRUEN = "#8ec07c"
ROT = "#fb4934"          # wie urgent_workspace in ~/.config/i3/config

