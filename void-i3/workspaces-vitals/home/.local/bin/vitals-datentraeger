#!/bin/sh
# Dashboard-Pane "Datentraeger": Dateisysteme und SSD-Durchsatz.
#
# glances laeuft mit genau zwei Plugins. CPU, RAM, Netz und Prozesse zeigt
# btop im grossen Pane links schon, und zwar huebscher.
#   fs     -> Belegung der Partitionen (System und EFI)
#   diskio -> Lese- und Schreibrate der SSD
#
# Warum glances und nicht duf: glances ist ein echtes TUI. Es misst die
# Panebreite selbst und ordnet bei jeder Groessenaenderung neu an. duf
# dagegen sah in der Kommandosubstitution gar kein Terminal, riet auf
# 80 Spalten und zerriss in jedem schmaleren Pane.
#
# --disable-check-update: sonst fragt glances beim Start im Netz nach einer
#   neueren Version. Ein Dashboard soll beim Hochfahren nichts nachladen.
# -t 3: alle drei Sekunden neu.
exec glances \
    --disable-plugin all \
    --enable-plugin fs,diskio \
    --disable-check-update \
    --disable-cursor \
    -t 3
