# erst ueber der Warnschwelle -- und dann rot). Die Farbe ist hier also frei.
LILA = "#d3869b"

MD_NOTE = "\U000f075a"    # nf-md-music     -- steuerbarer Player
# Die Welle steht fuer "hier kommt Ton her, steuern laesst er sich nicht".
# NICHT nf-md-waveform (U+F1954), obwohl die Icon-Liste das nahelegt: in der
# hier installierten Schriftfassung sitzt an der Stelle ein durchgestrichener
# Kreis, und der liest sich in einer Leiste als "gesperrt". Glyphen vor dem
# Einbau ansehen, nicht aus der Tabelle uebernehmen -- derselbe Fallstrick
# wie bei den Scancodes der F-Tasten.
MD_WELLE = "\U000f095b"   # nf-md-sine_wave -- Ton ohne Steuerung
MD_PAUSE = "\U000f03e4"   # nf-md-pause     -- laeuft, Klick haelt an
MD_PLAY = "\U000f040a"    # nf-md-play      -- haelt, Klick spielt weiter

# Wie lang ein Programmname hoechstens sein darf. Ohne Grenze schoebe ein
# langer Name ("Brave Web Browser") die halbe Leiste nach links.
MD_BREITE = 16

# Wie beim Bluetooth-Block: die Monitore melden viel mehr, als gebraucht
# wird. "pactl subscribe" feuert bei JEDEM Signalton mit, "playerctl -F"
# bei jeder Sekunde Spielzeit -- ohne Drosselung liefe fuer jede dieser
# Meldungen ein Prozess an.
MD_DROSSEL = 0.3

# Wie oft ohne Meldung nachgefragt wird: jede vierte i3status-Zeile, bei
# 5 s Takt also alle 20 Sekunden. Ein Netz gegen verpasste Ereignisse --
# im Normalfall kommt alles ueber die beiden Monitore.
MD_TAKT = 4

# None heisst "noch nichts gelesen". Ein dict mit quelle "nichts" heisst
# "es laeuft nichts" -- dann faellt der Block weg.
medien = None
medien_gelesen = 0.0
medien_uhr = None
# Wer in dieser Sitzung schon gespielt hat. Ohne dieses Gedaechtnis waere
# nicht zu unterscheiden, ob ein pausierter Player gerade angehalten wurde
# oder nur ein geladenes Video ist, das nie lief.
medien_gespielt = set()
medien_monitor_laeuft = False
medien_ton_laeuft = False
medien_zaehler = 0

# Alle laufenden Lauscher-Prozesse (gdbus, dbus-monitor, playerctl, pactl).
#
# WARUM eine Liste: die Monitore sind eigene Prozesse, und beim Beenden der
# Leiste blieben sie sonst als Waisen mit PPID 1 zurueck -- bei jedem
# "i3-msg restart" ein Satz mehr, bis dutzende gdbus-Prozesse auf einem
# leeren Bus lauschen. Aufgefallen beim Einbau des Medien-Blocks, gegolten
# hat es fuer die Glocke und Bluetooth aber schon vorher.
kinder = []
kinder_schloss = threading.Lock()

anzahl = 0
letzte_zeile = []
schloss = threading.Lock()
monitor_laeuft = False
bt_monitor_laeuft = False


def kind_merken(prozess):
    """Einen Lauscher-Prozess vormerken, damit er beim Beenden mitgeht."""
    with kinder_schloss:
        kinder[:] = [k for k in kinder if k.poll() is None]  # Beendete raus
        kinder.append(prozess)
    return prozess


def kinder_beenden(*_):
    """Alle Lauscher mitnehmen und selbst gehen.

    Haengt an SIGTERM und SIGHUP, denn genau die schickt i3bar dem
    status_command beim Beenden (erst SIGTERM, SIGKILL erst danach). Ohne
    diesen Handler beendet Python sich bei SIGTERM sofort und laesst die
    Kinder stehen.
    """
    with kinder_schloss:
        liste = list(kinder)
        kinder.clear()
    for k in liste:
        try:
            k.terminate()
        except OSError:
            pass
    os._exit(0)


def verlauf_laenge():
    """Laenge des dunst-Verlaufs ueber die D-Bus-Eigenschaft historyLength."""
    try:
        fertig = subprocess.run(
            ["gdbus", "call", "--session", "--dest", DIENST,
             "--object-path", OBJEKT, "--method",
             "org.freedesktop.DBus.Properties.Get", SCHNITT, "historyLength"],
            capture_output=True, text=True, timeout=3)
        treffer = re.search(r"uint32 (\d+)", fertig.stdout)
        return int(treffer.group(1)) if treffer else 0
    except (OSError, subprocess.SubprocessError):
        return 0


def wlan_geblockt():
    """True, wenn der WLAN-Funk per rfkill abgeschaltet ist.

    Gelesen wird aus /sys statt ueber "rfkill list": das ist ein reiner
    Dateizugriff ohne eigenen Prozess und laeuft bei jedem Neuzeichnen mit.
    Ein Hard-Block (Schalter am Geraet) zaehlt als "aus" mit -- fuer die
    Anzeige ist er dasselbe, nur aufheben laesst er sich per Software nicht.
    """
    try:
        for eintrag in os.listdir(RFKILL):
            ordner = os.path.join(RFKILL, eintrag)
            with open(ordner + "/type", encoding="ascii") as d:
                if d.read().strip() != "wlan":
                    continue
            for was in ("soft", "hard"):
                with open(ordner + "/" + was, encoding="ascii") as d:
                    if d.read().strip() == "1":
                        return True
    except OSError:
        pass
    return False


def wlan_block_ersetzen(bloecke):
    """i3status kennt nur "verbunden" und "nicht verbunden" -- abgeschaltetes
    WLAN sieht dort aus wie ein Funkloch. Seit der Block anklickbar ist, muss
    der Unterschied sichtbar sein: sonst weiss man nach einem Klick nicht, ob
    man den Funk ausgeschaltet hat oder nur gerade keine Verbindung da ist.

    Der Block wird kopiert, nicht geaendert: letzte_zeile haelt dieselben
    Objekte fuer das Neuzeichnen fest.
    """
    global wlan_verbindet
    if wlan_geblockt():
        wlan_verbindet = False
        return [dict(b, full_text=WLAN_AUS_TEXT) if b.get("name") == "wireless" else b
                for b in bloecke]
    if not wlan_verbindet:
        return bloecke
    # Steht die Verbindung, meldet i3status wieder die ESSID -- dann ist die
    # Zwischenanzeige erledigt. Erkennbar am Text von format_down, ein
    # eigenes Feld dafuer gibt es im i3bar-Protokoll nicht.
    aus = []
    for b in bloecke:
        if b.get("name") != "wireless":
            aus.append(b)
        elif "kein WLAN" in b.get("full_text", ""):
            aus.append(dict(b, full_text=WLAN_SUCHT_TEXT))
        else:
            wlan_verbindet = False
            aus.append(b)
    return aus


def i3status_wecken():
    """i3status sofort eine neue Zeile schreiben lassen, statt bis zum
    naechsten Takt (5 s) zu warten -- dasselbe Signal, das auch ~/.local/bin/osd
    am Ende schickt."""
    try:
        subprocess.run(["pkill", "-SIGUSR1", "-x", "i3status"],
                       capture_output=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass


def nachziehen():
    """Nach dem Einschalten braucht wpa_supplicant ein paar Sekunden bis zur
    Verbindung (gemessen rund drei). Ohne Nachtreten stuende die Leiste
    solange auf "kein WLAN", obwohl der Funk laengst wieder laeuft."""
    global wlan_verbindet
    for _ in range(6):
        time.sleep(2)
        i3status_wecken()
    wlan_verbindet = False      # nach zwoelf Sekunden ist es kein Verbinden mehr


def wlan_umschalten():
    """Funk an- oder ausschalten.

    Geschaltet wird nicht mehr per rfkill von hier aus, sondern ueber
    ~/.local/bin/netz -- das ruft dasselbe rfkill auf, meldet den neuen Zustand
    aber zusaetzlich ueber dunst (D3 in ~/desktop-ideen.md). Die Richtung steht
    hier schon fest, darum "an"/"aus" und nicht "um": zwischen Lesen und
    Schalten laege sonst ein zweiter Blick auf rfkill.

    Ohne sudo moeglich, weil /dev/rfkill per udev-Regel der Gruppe wheel
    gehoert (/etc/udev/rules.d/60-rfkill-unblock.rules). In derselben Datei
    steht auch, warum dort ACTION=="add" stehen muss: ohne den Filter hebt
    udev jeden Block im selben Moment wieder auf.
    """
    aus = wlan_geblockt()
    try:
        subprocess.run([NETZ, "an" if aus else "aus"],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return
    global wlan_verbindet
    wlan_verbindet = aus    # eingeschaltet -> "verbindet ..." bis die ESSID steht
    neu_zeichnen()          # der ersetzte Block stimmt sofort
    i3status_wecken()
    if aus:
        threading.Thread(target=nachziehen, daemon=True).start()


def bt_abfragen():
    """Adapterzustand von ~/.local/bin/bluetooth holen.

    Die Abfrage laeuft ueber dasselbe Skript, das auch die Klicks ausfuehrt --
    so steht die Logik (bluetoothctl, rfkill, Namen der Geraete) an einer
    Stelle statt zweimal leicht verschieden. Kostet einen Prozess, faellt aber
    kaum ins Gewicht: aufgerufen wird sie nicht im Takt, sondern nur wenn
    bluez eine Aenderung meldet (siehe bt_monitor).
    """
    global bt, bt_gelesen, bt_puls_laeuft, bt_ziel
    bt_gelesen = time.monotonic()
    try:
        fertig = subprocess.run([BLUETOOTH, "zustand"],
                                capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        bt = {}                     # bluetoothd haengt oder ist weg
        return
    zeilen = fertig.stdout.splitlines()
    if not zeilen or zeilen[0].startswith("kein"):
        bt = {}
        return
    bt = {
        "an": zeilen[0].strip() == "an",
        "sucht": "sucht" in [z.strip() for z in zeilen[1:]],
        "geraete": [z.split("  ", 1)[1].strip()
                    for z in zeilen[1:] if z.startswith("verbunden: ")],
    }
    if bt_ziel is not None and bt["an"] == bt_ziel:
        bt_ziel = None              # umgeschaltet, Zwischenanzeige weg
    if bt["sucht"] and not bt_puls_laeuft:
        bt_puls_laeuft = True       # vor dem Start gesetzt, sonst laufen zwei
        threading.Thread(target=bt_suchanzeige, daemon=True).start()


def bt_suchanzeige():
    """Waehrend der Suche die Punkte weiterwandern lassen.

    Laeuft nur, solange wirklich gesucht wird, und fragt dabei ab und zu selbst
    nach: das Ende der Suche meldet bluez zwar, aber wenn diese eine Meldung
    verloren ginge, liefe die Anzeige sonst endlos weiter.
    """
    global bt_punkte, bt_puls_laeuft
    runde = 0
    while bt and bt.get("sucht"):
        time.sleep(PULS)
        bt_punkte = (bt_punkte + 1) % 4
        runde += 1
        if runde % 4 == 0:
            bt_abfragen()
        neu_zeichnen()
    bt_punkte = 0
    bt_puls_laeuft = False
    neu_zeichnen()                  # letzter Stand ohne Punkte


def bt_uhr_stellen():
    """Eine gedrosselte Meldung in einer Sekunde nachholen.

    Ohne das koennte der Beginn einer Suche untergehen: er ist eine einzelne
    Meldung, und faellt sie in die Drosselung von bt_monitor, kaeme die
    naechste erst mit dem ersten gefundenen Geraet -- in einer leeren Umgebung
    also nie.
    """
    global bt_uhr
    if bt_uhr is not None and bt_uhr.is_alive():
        return
    bt_uhr = threading.Timer(1.0, lambda: (bt_abfragen(), neu_zeichnen()))
    bt_uhr.daemon = True
    bt_uhr.start()


def bt_block():
    """Der Bluetooth-Block, oder None solange kein Adapter bekannt ist."""
    if not bt:
        return None
    if bt_ziel is not None:
        # Gelb wie ueberall in dieser Leiste: "hier passiert gerade etwas".
        text = "  <span foreground='{0}'>{1}</span> <span foreground='{0}'>schaltet {2}</span>  ".format(
            GELB, BT_SUCHE, "an" if bt_ziel else "aus")
        return {"name": "bluetooth", "full_text": text, "markup": "pango"}
    if not bt["an"]:
        text = "  <span foreground='{0}'>{1}</span> <span foreground='{0}'>aus</span>  ".format(
            STUMPF, BT_AUS)
        return {"name": "bluetooth", "full_text": text, "markup": "pango"}

    if bt.get("sucht"):
        # Gelb ist in dieser Leiste die Farbe fuer "hier passiert gerade
        # etwas" (siehe Glocke und Akku). Die Punkte stehen auf fester Breite,
        # damit die Nachbarbloecke im Takt nicht hin und her rutschen.
        text = "  <span foreground='{0}'>{1}</span> <span foreground='{0}'>sucht{2}</span>  ".format(
            GELB, BT_SUCHE, ("." * bt_punkte).ljust(3))
        return {"name": "bluetooth", "full_text": text, "markup": "pango"}

    geraete = bt["geraete"]
    if not geraete:
        icon, wort = BT, "an"
    elif len(geraete) == 1:
        # Gekuerzt, damit ein langer Geraetename die Leiste nicht verschiebt;
        # escape(), weil der Name als Pango-Markup gelesen wird und ein "&"
        # im Namen sonst die ganze Zeile ungueltig machen wuerde.
        icon, wort = BT_VERB, html.escape(geraete[0][:16])
    else:
        icon, wort = BT_VERB, "{} Geraete".format(len(geraete))
    text = "  <span foreground='{}'>{}</span> <span foreground='{}'>{}</span>  ".format(
        BLAU, icon, GRAU, wort)
    return {"name": "bluetooth", "full_text": text, "markup": "pango"}


def bt_einfuegen(bloecke):
    """Den Bluetooth-Block links neben das WLAN haengen -- die beiden Funk-
    Anzeigen stehen damit beieinander. Ohne WLAN-Block kommt er ans Ende der
    i3status-Bloecke, also noch vor die Glocke."""
    block = bt_block()
    if block is None:
        return bloecke
    stelle = len(bloecke)
    for i, b in enumerate(bloecke):
        if b.get("name") == "wireless":
            stelle = i
            break
    return bloecke[:stelle] + [block] + bloecke[stelle:]


def bt_nachziehen():
    """Nach einem Klick den Zustand nachlesen: Ein- und Ausschalten laeuft
    ueber mehrere Zwischenstufen ("off-enabling"), und der letzte Schritt
    kommt erst nach gut einer Sekunde.

    Kurzer Takt statt der frueheren 1,5 s: solange bt_ziel steht, zeigt der
    Block "schaltet ...", und der soll nicht laenger stehen bleiben als noetig.
    Die Abfrage kostet rund 35 ms, zwoelf davon fallen nicht ins Gewicht.
    """
    global bt_ziel
    for _ in range(12):
        time.sleep(0.4)
        bt_abfragen()
        neu_zeichnen()
        if bt_ziel is None:
            return
    bt_ziel = None              # nicht angekommen -- lieber den Iststand zeigen
    neu_zeichnen()


def bt_monitor():
    """Auf Aenderungen von org.bluez lauschen -- gleiche Bauart wie monitor()
    fuer dunst, nur auf dem System-Bus.

    Gemeldet wird jedes PropertiesChanged; waehrend einer Geraetesuche sind
    das viele pro Sekunde. Darum wird hoechstens einmal je Sekunde wirklich
    nachgefragt, sonst liefe fuer jedes gefundene Geraet ein Prozess an."""
    global bt_monitor_laeuft
    if not shutil.which("stdbuf"):
        return
    befehl = ["stdbuf", "-oL", "gdbus", "monitor", "--system", "--dest", "org.bluez"]
    while True:
        try:
            lauscher = kind_merken(subprocess.Popen(
                befehl, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                encoding="utf-8", errors="replace"))
        except OSError:
            return
        bt_monitor_laeuft = True
        for _zeile in lauscher.stdout:
            if time.monotonic() - bt_gelesen < 1.0:
                bt_uhr_stellen()    # gedrosselt, aber nicht vergessen
                continue
            bt_abfragen()
            neu_zeichnen()
        bt_monitor_laeuft = False
        # bluetoothd neu gestartet oder gar nicht da: warten, dann neu binden
        time.sleep(5)
        bt_abfragen()
        neu_zeichnen()


def ts_wunschpeer():
    """Der Rechnername aus TS_PEER_DATEI, oder None fuer die Selbstsuche."""
    try:
        with open(TS_PEER_DATEI, encoding="utf-8") as d:
            return d.read().strip() or None
    except OSError:
        return None


def ts_abfragen():
    """Zustand von tailscale holen: laeuft das Tailnet, und wie steht es um
    die Gegenstelle.

    Ueber "tailscale status --json" und nicht ueber den Unix-Socket in
    /var/run/tailscale: der Socket ginge auch (er ist fuer alle lesbar), die
    Antwort kommt aber chunked und muesste hier von Hand ausgepackt werden --
    fuer eine Abfrage je halbe Minute lohnt das nicht.
    """
    global ts
    if not shutil.which("tailscale"):
        ts = None
        return
    try:
        fertig = subprocess.run(["tailscale", "status", "--json"],
                                capture_output=True, text=True, timeout=8)
        daten = json.loads(fertig.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        ts = {"zustand": "weg"}         # tailscaled laeuft nicht oder haengt
        return

    zustand = daten.get("BackendState", "")
    if zustand == "Stopped":
        ts = {"zustand": "aus"}
        return
    if daten.get("LoggedOut") or zustand in ("NeedsLogin", "NeedsMachineAuth",
                                             "NoState"):
        # Der wichtigste Zustand ueberhaupt: Schluessel abgelaufen. Das
        # passiert still nach Monaten, und ohne Anzeige faellt es erst auf,
        # wenn eine Verbindung unerklaerlich nicht mehr zustande kommt.
        ts = {"zustand": "login"}
        return
    if zustand == "Starting":
        ts = {"zustand": "startet"}
        return

    peers = list(daten.get("Peer", {}).values())
    wunsch = ts_wunschpeer()
    if wunsch:
        peers = [p for p in peers if p.get("HostName") == wunsch]
    else:
        peers = [p for p in peers if p.get("OS") not in TS_MOBIL]

    ts = {
        "zustand": "an",
        "peers": [{
            "name": p.get("HostName") or "?",
            "online": bool(p.get("Online")),
            # "Relay" taugt nicht als Merkmal fuer eine Umleitung: dort steht
            # immer der zugewiesene DERP-Heimatserver, auch bei einer direkten
            # Verbindung. Direkt ist genau dann, wenn eine CurAddr steht.
            "direkt": bool(p.get("CurAddr")),
        } for p in peers],
    }


def ts_block():
    """Der Tailscale-Block, oder None wenn es kein tailscale gibt."""
    if ts is None:
        return None
    zustand = ts["zustand"]

    if zustand == "aus":
        icon, farbe, wort, wortfarbe = TS_AUS, STUMPF, "aus", STUMPF
    elif zustand == "weg":
        icon, farbe, wort, wortfarbe = TS_AUS, ROT, "weg", ROT
    elif zustand == "login":
        icon, farbe, wort, wortfarbe = TS_LOGIN, ROT, "Login", ROT
    elif zustand == "startet":
        icon, farbe, wort, wortfarbe = TS_AN, GELB, "startet", GRAU
    else:
        peers = ts["peers"]
        drin = [p for p in peers if p["online"]]
        if not peers:
            # Im Tailnet, aber keine Gegenstelle im Blick: dann sagt der Block
            # nur, dass die Verbindung selbst steht.
            icon, farbe, wort, wortfarbe = TS_AN, GRUEN, "an", GRAU
        elif len(peers) == 1:
            peer = peers[0]
            # Gekuerzt und escaped aus demselben Grund wie beim Bluetooth: der
            # Name kommt von aussen und wird als Pango-Markup gelesen.
            name = html.escape(peer["name"][:16])
            if not peer["online"]:
                icon, farbe, wort, wortfarbe = TS_AUS, GRAU, name + " weg", GRAU
            elif peer["direkt"]:
                icon, farbe, wort, wortfarbe = TS_AN, GRUEN, name, GRAU
            else:
                # Erreichbar, aber der Verkehr laeuft ueber einen Relay-Server
                # statt direkt -- geht, ist aber spuerbar langsamer. Gelb ist
                # in dieser Leiste die Farbe fuer "hier stimmt etwas nicht ganz".
                icon, farbe, wort, wortfarbe = TS_AN, GELB, name, GRAU
        else:
            icon = TS_AN if drin else TS_AUS
            farbe = GRUEN if len(drin) == len(peers) else (GELB if drin else GRAU)
            wort, wortfarbe = "{}/{}".format(len(drin), len(peers)), GRAU

    text = "  <span foreground='{}'>{}</span> <span foreground='{}'>{}</span>  ".format(
        farbe, icon, wortfarbe, wort)
    return {"name": "tailscale", "full_text": text, "markup": "pango"}


def ts_einfuegen(bloecke):
    """Rechts neben das WLAN haengen: erst der Funk, dann das lokale Netz,
    dann das Netz darueber. Ohne WLAN-Block ans Ende der i3status-Bloecke,
    also noch vor die Glocke."""
    block = ts_block()
    if block is None:
        return bloecke
    stelle = len(bloecke)
    for i, b in enumerate(bloecke):
        if b.get("name") == "wireless":
            stelle = i + 1
            break
    return bloecke[:stelle] + [block] + bloecke[stelle:]


def ts_nachziehen():
    """Nach einem Klick nachlesen. "tailscale up" meldet sich sofort zurueck,
    die Verbindung zur Gegenstelle steht aber erst ein paar Sekunden spaeter --
    ohne Nachtreten stuende der Block solange auf "weg"."""
    for _ in range(5):
        time.sleep(2)
        ts_abfragen()
        neu_zeichnen()


def ts_umschalten():
    """Tailnet an- oder abschalten.

    Ohne sudo moeglich, weil der eigene Benutzer bei tailscaled als Operator
    eingetragen ist ("tailscale set --operator=..."). Steht dort ein anderer
    Name -- etwa noch der alte Benutzername von vor einer Umbenennung --,
    laeuft der Befehl ins Leere und der Klick bliebe wirkungslos.
    """
    if ts is None:
        return
    aus = ts["zustand"] in ("aus", "weg")
    try:
        # Ueber ~/.local/bin/netz statt direkt ueber tailscale: dort haengt die
        # dunst-Meldung dran. "ts-an"/"ts-aus" statt "ts-um", weil die Richtung
        # hier aus dem genaueren Leisten-Zustand kommt -- bei "weg" laeuft das
        # Tailnet formal, und der Klick soll noch einmal "up" schicken.
        subprocess.Popen([NETZ, "ts-an" if aus else "ts-aus"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return
    threading.Thread(target=ts_nachziehen, daemon=True).start()


def medien_abfragen():
    """Den Zustand von ~/.local/bin/medien holen (siehe dort).

    Wie bt_abfragen ueber ein eigenes Skript statt ueber playerctl direkt:
    die Erkennung -- MPRIS, PipeWire, der Filter gegen die eigenen
    Signaltoene -- steht damit an einer Stelle und ist im Terminal
    nachvollziehbar. Kostet rund 35 ms, laeuft aber nicht im Takt, sondern
    nur wenn ein Monitor etwas meldet.
    """
    global medien, medien_gelesen
    medien_gelesen = time.monotonic()
    try:
        fertig = subprocess.run([MEDIEN, "zustand"],
                                capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        medien = None               # kein playerctl, kein pactl -- Block weg
        return
    werte = {}
    for zeile in fertig.stdout.splitlines():
        schluessel, trenner, wert = zeile.partition(":")
        if trenner:
            werte[schluessel.strip()] = wert.strip()
    if not werte.get("quelle"):
        medien = None
        return
    medien = werte
    player = werte.get("player", "")
    if werte.get("status") == "spielt" and player:
        medien_gespielt.add(player)
    elif werte.get("quelle") == "nichts":
        # Kein Player mehr da: das Gedaechtnis kann weg, sonst sammelt es
        # ueber Tage die Instanznamen geschlossener Browser-Tabs.
        medien_gespielt.clear()


def medien_lief_schon():
    """Hat dieser pausierte Player ueberhaupt schon einmal gespielt?

    Zwei Wege, weil keiner allein reicht: das Gedaechtnis medien_gespielt
    vergisst alles beim Neustart der Leiste, und nicht jeder Player fuehrt
    eine Position. Zusammen decken sie beide Faelle ab -- nach einem
    "i3 restart" bleibt der angehaltene Titel sichtbar, weil seine Position
    nicht mehr null ist.
    """
    if not medien:
        return False
    if medien.get("player") in medien_gespielt:
        return True
    try:
        return float(medien.get("position", "0")) > 0
    except ValueError:
        return False


def medien_block():
    """Der Medien-Block, oder None wenn gerade nichts zu zeigen ist."""
    if not medien:
        return None
    quelle = medien.get("quelle")
    name = html.escape(medien.get("programm", "")[:MD_BREITE])
    if not name:
        return None

    if quelle == "ton":
        # Ton ohne MPRIS: das Programm laesst sich nicht anhalten, also
        # steht hier auch kein Knopf, der etwas verspraeche. Die Wellenform
        # sagt "von hier kommt der Ton", mehr kann diese Quelle nicht.
        text = "  <span foreground='{}'>{}</span> <span foreground='{}'>{}</span>  ".format(
            LILA, MD_WELLE, GRAU, name)
        return {"name": "medien", "full_text": text, "markup": "pango"}

    if quelle != "mpris":
        return None

    if medien.get("status") == "spielt":
        farbe, knopf = LILA, MD_PAUSE
        namensfarbe = GRAU
    else:
        if not medien_lief_schon():
            return None             # geladen, aber nie gelaufen -- kein Block
        # Stumpf wie das ausgeschaltete WLAN und das ausgeschaltete
        # Bluetooth: der Block ist da, aber er ruht.
        farbe, knopf = STUMPF, MD_PLAY
        namensfarbe = STUMPF

    text = ("  <span foreground='{0}'>{1}</span> <span foreground='{2}'>{3}</span>"
            " <span foreground='{0}'>{4}</span>  ").format(
        farbe, MD_NOTE, namensfarbe, name, knopf)
    return {"name": "medien", "full_text": text, "markup": "pango"}


def medien_einfuegen(bloecke):
    """Links neben den Ton-Block haengen -- beides betrifft den Lautsprecher,
    und der Weg von "was spielt" zu "wie laut" ist dann einer. Ohne
    Ton-Block ans Ende der i3status-Bloecke."""
    block = medien_block()
    if block is None:
        return bloecke
    stelle = len(bloecke)
    for i, b in enumerate(bloecke):
        if b.get("name") == "volume":
            stelle = i
            break
    return bloecke[:stelle] + [block] + bloecke[stelle:]


def medien_uhr_stellen():
    """Eine gedrosselte Meldung gleich nachholen -- wie bt_uhr_stellen.

    Ohne das ginge ausgerechnet die letzte Meldung einer Salve verloren,
    und das ist meist die entscheidende: beim Pausieren schickt ein Browser
    mehrere Aenderungen dicht hintereinander, die letzte traegt den neuen
    Status.
    """
    global medien_uhr
    if medien_uhr is not None and medien_uhr.is_alive():
        return
    medien_uhr = threading.Timer(MD_DROSSEL,
                                 lambda: (medien_abfragen(), neu_zeichnen()))
    medien_uhr.daemon = True
    medien_uhr.start()


def medien_gemeldet():
    """Ein Monitor hat etwas gesehen: nachlesen, aber hoechstens alle
    MD_DROSSEL Sekunden."""
    if time.monotonic() - medien_gelesen < MD_DROSSEL:
        medien_uhr_stellen()
        return
    medien_abfragen()
    neu_zeichnen()


def medien_monitor():
    """Auf MPRIS lauschen: "playerctl -F" meldet jeden Wechsel von Player,
    Status und Titel -- auch das Auftauchen und Verschwinden von Playern.

    Der Inhalt der Zeilen wird nicht gelesen, nur ihr Eintreffen: was gilt,
    holt medien_abfragen ueber ~/.local/bin/medien, damit die Auswertung
    nicht zweimal leicht verschieden dasteht.

    stdbuf -oL aus demselben Grund wie bei monitor(): ohne Zeilenpuffer
    kaeme die erste Meldung erst nach ein paar Kilobyte.
    """
    global medien_monitor_laeuft
    if not shutil.which("stdbuf") or not shutil.which("playerctl"):
        return
    befehl = ["stdbuf", "-oL", "playerctl", "-a", "-F", "status"]
    while True:
        try:
            lauscher = kind_merken(subprocess.Popen(
                befehl, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                encoding="utf-8", errors="replace"))
        except OSError:
            return
        medien_monitor_laeuft = True
        for _zeile in lauscher.stdout:
            medien_gemeldet()
        medien_monitor_laeuft = False
        # Ohne einen einzigen Player beendet sich playerctl -F sofort. Dann
        # ist Warten richtig: erscheint spaeter einer, faengt ihn der
        # naechste Durchlauf -- laengstens nach drei Sekunden.
        time.sleep(3)


def medien_ton_monitor():
    """Auf PipeWire lauschen -- fuer alles, was kein MPRIS spricht.

    "pactl subscribe" meldet jedes Kommen und Gehen eines Streams. Das ist
    reichlich (jeder Signalton steht mit drin), darum die Drosselung in
    medien_gemeldet; herausgefiltert werden die eigenen Toene erst in
    ~/.local/bin/medien.
    """
    global medien_ton_laeuft
    if not shutil.which("stdbuf") or not shutil.which("pactl"):
        return
    befehl = ["stdbuf", "-oL", "pactl", "subscribe"]
    while True:
        try:
            lauscher = kind_merken(subprocess.Popen(
                befehl, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                encoding="utf-8", errors="replace"))
        except OSError:
            return
        medien_ton_laeuft = True
        for zeile in lauscher.stdout:
            if "sink-input" in zeile:
                medien_gemeldet()
        medien_ton_laeuft = False
        time.sleep(5)               # pipewire-pulse neu gestartet oder weg


def medien_nachziehen():
    """Nach einem Klick den wirklichen Stand nachlesen.

    Ein Browser bestaetigt Play/Pause nicht sofort -- bei Chrome liegen
    zwischen Klick und neuer MPRIS-Meldung gut zwei Zehntel. Bis dahin
    steht in der Leiste der vorweggenommene Stand aus medien_klick.
    """
    for _ in range(8):
        time.sleep(0.25)
        medien_abfragen()
        neu_zeichnen()


def medien_klick(taste):
    """Linksklick Play/Pause, Rechtsklick zum Fenster, Mausrad vor/zurueck."""
    if not medien or medien.get("quelle") == "nichts":
        return
    if taste == 1:
        if medien.get("quelle") != "mpris":
            return                  # ein PipeWire-Stream laesst sich nicht halten
        # Rueckmeldung im selben Moment wie der Klick: den erwarteten Stand
        # sofort zeichnen, statt bis zur Antwort des Players auf dem alten
        # stehen zu bleiben. medien_nachziehen holt danach den echten.
        medien["status"] = "pausiert" if medien.get("status") == "spielt" else "spielt"
        neu_zeichnen()
        subprocess.run([MEDIEN, "um"], capture_output=True)
        medien_nachziehen()
    elif taste == 3:
        subprocess.run([MEDIEN, "fenster"], capture_output=True)
    elif taste in (4, 5):
        if medien.get("quelle") != "mpris":
            return
        subprocess.run([MEDIEN, "vor" if taste == 4 else "zurueck"],
                       capture_output=True)
        medien_nachziehen()


def vitals_zeigen():
    """Auf die Vitals-Flaeche wechseln.

    Das Dashboard startet beim Anmelden mit und wird per "assign" auf diese
    Flaeche gelegt; im Normalfall ist der Klick also nur ein Wechsel. Wurde
    das Terminal doch einmal geschlossen (die zellij-Session ueberlebt das,
    zu sehen ist davon aber nichts), wird es hier neu gestartet -- sonst
    landete der Klick auf einer leeren Flaeche.
    """
    subprocess.run(["i3-msg", "workspace", "number", VITALS_FLAECHE],
                   capture_output=True, timeout=5)
    try:
        baum = subprocess.run(["i3-msg", "-t", "get_tree"],
                              capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return
    if '"class": "{}"'.format(VITALS_KLASSE) in baum:
        return
    subprocess.Popen(["alacritty", "--class", VITALS_KLASSE, "-e", VITALS_START],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def system_zusammenfassen(bloecke):
    """CPU, Temperatur, RAM und Platte zu einem Block "system" verschmelzen.

    Angezeigt wird im Normalfall nur der CPU-Block, sonst die Bloecke, die
    gerade rot sind: bei knappem Speicher steht also der Speicherwert da, bei
    heisser CPU die Temperatur -- die Leiste bleibt ruhig, meldet sich aber,
    wenn etwas ist. Alles zusammen zeigt ein Linksklick (siehe klicks()).

    Uebernommen wird der fertige full_text von i3status; Icons, Farben und
    Abstaende bleiben damit genau die aus ~/.config/i3status/config, hier
    wird nichts nachgebaut. Die Bloecke werden auch nicht veraendert, nur
    ausgelassen: letzte_zeile haelt dieselben Objekte fuers Neuzeichnen fest.
    """
    teile = [b for b in bloecke if b.get("name") in SYSTEM_MODULE]
    if not teile:
        return bloecke
    warnend = [b for b in teile if WARNROT in b.get("full_text", "")]
    zeigen = warnend or [b for b in teile if b.get("name") == "cpu_usage"] or teile[:1]
    block = {
        "name": "system",
        "full_text": "".join(b.get("full_text", "") for b in zeigen),
        "markup": "pango",
    }
    aus = []
    for b in bloecke:
        if b.get("name") not in SYSTEM_MODULE:
            aus.append(b)
        elif b is teile[0]:         # der neue Block sitzt an der Stelle des ersten
            aus.append(block)
    return aus


def zeit_zusammenfassen(bloecke):
    """Datum und Uhr zu einem Block "zeit" verschmelzen.

    i3status liefert beide als eigenen Block (name "tztime", unterschieden
    ueber instance "date" bzw. "local"). Als zwei Bloecke zeichnet i3bar
    dazwischen einen Trenner und haelt Abstand -- verschmolzen stehen sie
    dicht beieinander und lesen sich als eine Angabe. Die Texte kommen
    unveraendert aus ~/.config/i3status/config, die Abstaende stecken dort
    in den Formaten.
    """
    teile = [b for b in bloecke if b.get("name") == "tztime"]
    if len(teile) < 2:
        return bloecke
    block = {
        "name": "zeit",
        "full_text": "".join(b.get("full_text", "") for b in teile),
        "markup": "pango",
    }
    aus = []
    for b in bloecke:
        if b.get("name") != "tztime":
            aus.append(b)
        elif b is teile[0]:         # der neue Block sitzt an der Stelle des ersten
            aus.append(block)
    return aus


def akku_abtrennen(bloecke):
    """Den Akku-Block aus der Reihe nehmen -- er kommt in ausgeben() ganz
    nach rechts. Rueckgabe: (Rest, Akku-Bloecke).

    Das Padding wird hier gesetzt und nicht in ~/.config/i3status/config:
    i3status schneidet Leerzeichen am Rand des battery-Formats ab. Ohne den
    Zuschlag klebt der Prozentwert am rechten Bildschirmrand, und i3bar
    schneidet dort die letzte Ziffer ab.
    """
    akku = [dict(b, full_text="  " + b.get("full_text", "") + "   ")
            for b in bloecke if b.get("name") == "battery"]
    rest = [b for b in bloecke if b.get("name") != "battery"]
    return rest, akku


def glocken_block():
    # Padding und Trenner wie bei den uebrigen Bloecken: die Glocke stand
    # frueher rechts aussen (dort waere ein Trenner ins Leere gezeichnet
    # worden), seit dem Umbau steht rechts von ihr noch der Akku.
    if anzahl:
        text = "  <span foreground='{}'>{}</span> <span foreground='{}'>{}</span>  ".format(
            GELB, GLOCKE, GRAU, anzahl)
    else:
        text = "  <span foreground='{}'>{}</span>  ".format(STUMPF, GLOCKE_AUS)
    return {
        "name": "dunst",
        "full_text": text,
        "markup": "pango",
    }


def ausgeben(bloecke):
    """Eine Zeile des i3bar-Protokolls schreiben. i3bar zeichnet den ersten
    Block links und den letzten rechts; die Reihenfolge rechts aussen wird
    darum hier festgelegt und nicht ueber "order" in der i3status-Konfiguration:

        ... System, Bluetooth, WLAN, Tailscale, Medien, Ton | Datum+Uhr | Glocke | Akku

    ensure_ascii=False: die Icons sollen als echtes UTF-8 rausgehen wie bei
    i3status auch, nicht als \\uXXXX-Ersatzpaare."""
    bloecke = zeit_zusammenfassen(medien_einfuegen(ts_einfuegen(bt_einfuegen(
        wlan_block_ersetzen(system_zusammenfassen(bloecke))))))
    rest, akku = akku_abtrennen(bloecke)
    zeile = rest + [glocken_block()] + akku
    with schloss:
        sys.stdout.write(json.dumps(zeile, ensure_ascii=False) + ",\n")
        sys.stdout.flush()


def neu_zeichnen():
    """Leiste sofort neu ausgeben, ohne auf die naechste i3status-Zeile zu warten."""
    if letzte_zeile is not None:
        ausgeben(letzte_zeile)


def monitor():
    """Auf Aenderungen von historyLength lauschen (siehe Kopf)."""
    global anzahl, monitor_laeuft
    muster = re.compile(r"'historyLength': <uint32 (\d+)>")
    # stdbuf -oL ist hier keine Kosmetik: gdbus schreibt ueber die C-Bibliothek
    # und puffert blockweise, sobald die Ausgabe kein Terminal ist. Ohne den
    # Zeilenpuffer kaeme das erste Signal erst nach ein paar Kilobyte an --
    # die Zahl an der Glocke haette tagelang stillgestanden.
    if not shutil.which("stdbuf"):
        return              # ohne Zeilenpuffer lieber gleich abfragen lassen
    befehl = ["stdbuf", "-oL", "gdbus", "monitor", "--session", "--dest", DIENST]
    while True:
        try:
            lauscher = kind_merken(subprocess.Popen(
                befehl, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                encoding="utf-8", errors="replace"))
        except OSError:
            return                      # kein gdbus -- dann eben abfragen
        monitor_laeuft = True
        for zeile in lauscher.stdout:
            treffer = muster.search(zeile)
            if treffer:
                anzahl = int(treffer.group(1))
                neu_zeichnen()
        monitor_laeuft = False
        # dunst neu gestartet oder D-Bus weg: kurz warten, dann neu verbinden
        time.sleep(5)
        anzahl = verlauf_laenge()
        neu_zeichnen()


def nebenlaeufig(arbeit):
    """Eine Klickaktion in einem eigenen Thread erledigen.

    WARUM: i3bar schickt die Klicks durch eine Pipe und wartet, bis sie
    angenommen sind. Wird in klicks() selbst gearbeitet, laeuft die Pipe voll
    und i3bar blockiert beim Schreiben -- dann reagiert die GANZE Leiste
    nicht mehr, auch die Arbeitsflaechen-Knoepfe, die i3bar sonst allein
    bedient. Hier wird darum nur verteilt; gearbeitet wird nebenan.
    """
    threading.Thread(target=arbeit, daemon=True).start()


def dunst_klick(taste):
    """Verlauf oeffnen oder leeren, danach die Zahl an der Glocke nachziehen."""
    global anzahl
    if taste == 1:
        subprocess.Popen([VERLAUF])
    elif taste == 3:
        subprocess.run(
            ["gdbus", "call", "--session", "--dest", DIENST,
             "--object-path", OBJEKT, "--method",
             SCHNITT + ".NotificationClearHistory"],
            capture_output=True)
    anzahl = verlauf_laenge()
    neu_zeichnen()


def bluetooth_klick(taste):
    global bt_ziel
    if taste == 1:
        if bt:
            bt_ziel = not bt["an"]
            neu_zeichnen()      # Rueckmeldung im selben Moment wie der Klick
        subprocess.Popen([BLUETOOTH, "um"])
        bt_nachziehen()
    elif taste == 3:
        subprocess.Popen([BLUETOOTH])


def klicks():
    """Klick-Ereignisse von i3bar lesen und verteilen. Sie kommen als
    JSON-Strom: erst "[", dann je Klick ein Objekt, ab dem zweiten mit
    fuehrendem Komma.

    Hier wird nichts ausgefuehrt, was laenger als ein Wimpernschlag dauert --
    siehe nebenlaeufig().
    """
    for zeile in sys.stdin:
        zeile = zeile.strip().lstrip(",")
        if not zeile or zeile == "[":
            continue
        try:
            ereignis = json.loads(zeile)
        except ValueError:
            continue
        name = ereignis.get("name")
        taste = ereignis.get("button")

        if name == "volume":
            if taste == 1:
                subprocess.Popen([OSD, "stumm"])
            elif taste == 4:
                subprocess.Popen([OSD, "lauter"])
            elif taste == 5:
                subprocess.Popen([OSD, "leiser"])
            continue

        if name == "system":
            if taste == 1:
                nebenlaeufig(vitals_zeigen)
            continue

        if name == "wireless":
            if taste == 1:
                nebenlaeufig(wlan_umschalten)
            elif taste == 3:
                subprocess.Popen([NETZ])
            continue

        if name == "tailscale":
            if taste == 1:
                nebenlaeufig(ts_umschalten)
            continue

        if name == "bluetooth":
            nebenlaeufig(lambda: bluetooth_klick(taste))
            continue

        if name == "medien":
            nebenlaeufig(lambda: medien_klick(taste))
            continue

        if name == "battery":
            # Kein nebenlaeufig(): beide Aufrufe kehren sofort zurueck, das
            # rofi-Fenster haelt nur seinen eigenen Prozess auf.
            if taste == 1:
                subprocess.Popen([AKKU])
            elif taste == 3:
                subprocess.Popen([AKKU, "zustand"])
            continue

        if name == "dunst":
            nebenlaeufig(lambda: dunst_klick(taste))


def main():
    global anzahl, letzte_zeile, ts_zaehler, medien_zaehler
    # Ein- und Ausgabe fest auf UTF-8: die Icons sind Nerd-Font-Zeichen, und
    # welche Locale i3bar dem Skript vererbt, ist nicht garantiert.
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stdin.reconfigure(encoding="utf-8", errors="replace")
    for zeichen in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(zeichen, kinder_beenden)
    i3status = kind_merken(subprocess.Popen(["i3status"], stdout=subprocess.PIPE,
                                            encoding="utf-8", errors="replace"))
    anzahl = verlauf_laenge()
    bt_abfragen()
    ts_abfragen()
    medien_abfragen()

    # Kopfzeile von i3status uebernehmen und um click_events ergaenzen
    kopf = json.loads(i3status.stdout.readline())
    kopf["click_events"] = True
    print(json.dumps(kopf), flush=True)
    print(i3status.stdout.readline().strip(), flush=True)     # die oeffnende "["

    threading.Thread(target=klicks, daemon=True).start()
    threading.Thread(target=monitor, daemon=True).start()
    threading.Thread(target=bt_monitor, daemon=True).start()
    threading.Thread(target=medien_monitor, daemon=True).start()
    threading.Thread(target=medien_ton_monitor, daemon=True).start()

    for zeile in i3status.stdout:
        zeile = zeile.strip().lstrip(",")
        if not zeile:
            continue
        try:
            bloecke = json.loads(zeile)
        except ValueError:
            continue
        letzte_zeile = bloecke
        if not monitor_laeuft:          # Notnagel, falls der Monitor fehlt
            anzahl = verlauf_laenge()
        if not bt_monitor_laeuft:       # dasselbe fuer den Bluetooth-Block
            bt_abfragen()
        ts_zaehler += 1                 # gedrosselt, siehe TS_TAKT
        if ts_zaehler % TS_TAKT == 0:
            ts_abfragen()
        medien_zaehler += 1
        if not (medien_monitor_laeuft and medien_ton_laeuft):
            medien_abfragen()           # Notnagel, falls ein Monitor fehlt
        elif medien_zaehler % MD_TAKT == 0:
            medien_abfragen()           # Netz gegen verpasste Meldungen
        ausgeben(bloecke)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
