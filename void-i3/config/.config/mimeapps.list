[Default Applications]
x-scheme-handler/http=com.google.Chrome.desktop
x-scheme-handler/https=com.google.Chrome.desktop
text/html=com.google.Chrome.desktop

# Ordner bleiben bei PCManFM, damit "Ordner oeffnen" aus den Browser-
# Downloads weiter funktioniert.
inode/directory=pcmanfm.desktop

# Text, Markdown und Code gehen zum Bearbeiten in VS Code.
text/markdown=com.visualstudio.code.desktop
text/x-markdown=com.visualstudio.code.desktop
text/plain=com.visualstudio.code.desktop
application/x-shellscript=com.visualstudio.code.desktop
text/x-shellscript=com.visualstudio.code.desktop
text/x-python=com.visualstudio.code.desktop
application/json=com.visualstudio.code.desktop
application/toml=com.visualstudio.code.desktop
text/x-toml=com.visualstudio.code.desktop
application/x-yaml=com.visualstudio.code.desktop
text/x-yaml=com.visualstudio.code.desktop
text/x-csrc=com.visualstudio.code.desktop
text/x-chdr=com.visualstudio.code.desktop
text/x-c++src=com.visualstudio.code.desktop
text/x-c++hdr=com.visualstudio.code.desktop
text/rust=com.visualstudio.code.desktop
text/x-lua=com.visualstudio.code.desktop
text/javascript=com.visualstudio.code.desktop
application/javascript=com.visualstudio.code.desktop
text/css=com.visualstudio.code.desktop
text/x-makefile=com.visualstudio.code.desktop
text/x-log=com.visualstudio.code.desktop
text/x-diff=com.visualstudio.code.desktop
text/x-patch=com.visualstudio.code.desktop

# Bilder im richtigen Bildbetrachter statt als ASCII im Terminal.
image/jpeg=nsxiv.desktop
image/png=nsxiv.desktop
image/gif=nsxiv.desktop
image/webp=nsxiv.desktop
image/bmp=nsxiv.desktop
image/tiff=nsxiv.desktop
image/avif=nsxiv.desktop

[Added Associations]
# Diese tauchen im Rechtsklick unter "Oeffnen mit" auf, ohne Standard zu sein.
text/markdown=glow-alacritty.desktop;bat-alacritty.desktop;com.google.Chrome.desktop;
text/x-markdown=glow-alacritty.desktop;bat-alacritty.desktop;
text/plain=bat-alacritty.desktop;com.google.Chrome.desktop;
