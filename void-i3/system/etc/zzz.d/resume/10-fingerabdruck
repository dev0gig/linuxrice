#!/bin/sh
# 10-fingerabdruck -- nach dem Aufwachen den Fingerabdruckleser freiraeumen.
#
# Klappt der Deckel zu, sperrt /etc/acpi/deckel.sh erst und legt den Rechner
# dann schlafen. Der Fingerwaechter aus ~/.local/bin/i3-sitzung wartet zu
# diesem Zeitpunkt also schon in einem fprintd-verify -- und der ueberlebt
# die Bereitschaft nicht heil.
#
# Zwei Dinge dazu nachgemessen, weil beide gern falsch angenommen werden:
#
#   * Dieser Rechner kennt nur s2idle, kein S3: /sys/power/mem_sleep meldet
#     "[s2idle]" ohne weitere Wahl. Es wird also nichts abgeschaltet, nur
#     eingefroren.
#   * Der Leser meldet sich beim Aufwachen NICHT neu an. Im Kernel-Log steht
#     nach "PM: suspend exit" kein Reset von usb 3-6. Sein Griff wird aber
#     ruhend gelegt (/sys/bus/usb/devices/3-6/power/control ist "auto"), und
#     die laufende Uebertragung ueberlebt das nicht.
#
# Darum hier der Kahlschlag: den wartenden Pruefer beenden und fprintd dazu.
# fprintd wird ueber D-Bus gestartet (siehe
# /usr/share/dbus-1/system-services/net.reactivated.Fprint.service), es gibt
# also keinen Dienst zum Neustarten -- Beenden genuegt, der naechste Aufruf
# weckt ihn wieder und er sucht die Geraete neu. Der Waechter merkt das Ende
# seines Pruefers und startet binnen eines Taktes einen neuen.
#
# Laeuft als root aus /usr/bin/zzz heraus. pkill meldet 1, wenn nichts passte
# -- der Normalfall, wenn gerade nicht gesperrt war. Das darf den Hook nicht
# als Fehler beenden, daher das abschliessende "exit 0".

# ---------------------------------------------------------------------------
# Wer ist die laufende X-Sitzung?
#
# Das steht ganz oben, weil schon die Mitschrift darunter das Heimverzeichnis
# braucht. Der Benutzer wird am laufenden i3 abgelesen statt fest verdrahtet
# -- diese Datei liegt in einem oeffentlichen Repo. DISPLAY und XAUTHORITY
# kommen aus seiner Prozessumgebung, feste Werte waeren hier falsch: die
# X-Cookies haengen am Rechnernamen.
i3pid=$(pgrep -x i3 | head -n1)
benutzer=""
heim=""
anzeige=""
cookie=""
if [ -n "$i3pid" ]; then
    benutzer=$(ps -o user= -p "$i3pid" | tr -d ' ')
    heim=$(getent passwd "$benutzer" | cut -d: -f6)
    umgebung=$(tr '\0' '\n' < "/proc/$i3pid/environ" 2>/dev/null)
    anzeige=$(printf '%s\n' "$umgebung" | sed -n 's/^DISPLAY=//p'    | head -n1)
    cookie=$( printf '%s\n' "$umgebung" | sed -n 's/^XAUTHORITY=//p' | head -n1)
fi

# Dieselbe zuschaltbare Mitschrift wie im Waechter (~/.local/bin/i3-sitzung),
# damit sich beide Seiten in einer Zeitleiste lesen lassen. Der Hook laeuft
# als root, die Datei gehoert aber dem Benutzer -- darum wird nur geschrieben,
# wenn sie schon da ist, und der Besitzer bleibt unangetastet. Ist keine
# Sitzung auffindbar, faellt das Schreiben still aus.
PROTOKOLL="$heim/.cache/sperrbild/protokoll"
notiere() {
    [ -n "$heim" ] && [ -f "$PROTOKOLL" ] &&
        echo "$(date '+%H:%M:%S') resume-hook: $*" >> "$PROTOKOLL"
    return 0
}

notiere "aufgewacht"

# ---------------------------------------------------------------------------
# Den Ladekreis anschalten.
#
# Der Sperrbildschirm fragt sonst ab dem ersten Augenblick nach dem Finger --
# und der Leser kann in diesem Augenblick noch gar nichts. Genau darum geht
# es hier: solange "aufwachen" in der Zustandsdatei steht, zeigt sperrsaver
# an der Stelle des Fingerabdruck-Symbols einen laufenden Kreis. Abgeschaltet
# wird er vom Waechter in ~/.local/bin/i3-sitzung, sobald ein Pruefer den
# Sensor wirklich greift.
#
# Warum hier und nicht schon vor dem Schlafenlegen: dort liefe der Waechter
# noch mit einem gesunden Pruefer, und der wuerde den Kreis binnen einer
# Sekunde wieder abschalten. An dieser Stelle dagegen ist die Reihenfolge
# sicher -- der alte Pruefer faellt gleich darunter, und bis der Waechter
# einen neuen aufsetzt, vergeht mehr als eine Sekunde.
#
# Geschrieben wird als root in eine Datei des Benutzers. Der Besitz wird
# danach zurechtgerueckt: gehoerte sie root, koennte der Waechter den Kreis
# nicht mehr abschalten.
if [ -n "$heim" ] && pgrep -x xsecurelock >/dev/null 2>&1; then
    zustandsdatei="$heim/.cache/sperrbild/zustand"
    if [ -f "$zustandsdatei" ] && echo aufwachen > "$zustandsdatei" 2>/dev/null; then
        chown "$benutzer" "$zustandsdatei" 2>/dev/null
        notiere "Ladekreis an"
    fi
fi

# Erst die Klienten los, damit niemand den alten Griff festhaelt.
pkill -x fprintd-verify && notiere "wartenden fprintd-verify beendet"
pkill -x fprintd        && notiere "fprintd beendet"

# Dann den Leser wirklich neu anmelden. fprintd allein neu zu starten hat
# nicht gereicht -- gemessen am 22.08.2026: der frisch gestartete Pruefer
# lief zwar, erkannte den aufgelegten Finger aber nicht. Der Sensor ist ein
# Match-in-Sensor (Synaptics Tudor) und braucht nach dem Stromsparen offenbar
# seinen Anmelde-Handschlag von vorn.
#
# Die Kennung wird gesucht statt fest hingeschrieben: an welchem Port der
# Leser haengt, kann sich nach einem Neustart aendern.
for geraet in /sys/bus/usb/devices/*/; do
    [ -r "$geraet/idVendor" ] || continue
    [ "$(cat "$geraet/idVendor")$(cat "$geraet/idProduct")" = "06cb00e7" ] || continue
    kennung=$(basename "$geraet")
    printf '%s' "$kennung" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null
    printf '%s' "$kennung" > /sys/bus/usb/drivers/usb/bind   2>/dev/null
    notiere "Leser $kennung neu angemeldet"
    break
done

# Kurz warten, bis das Geraet wieder ansprechbar ist. Ohne das laufen die
# Versuche des Waechters in den ersten Augenblicken ins Leere -- das heilt
# zwar von selbst, fuellt aber die Mitschrift mit Fehlern.
n=0
while [ "$n" -lt 30 ]; do
    [ -e "/sys/bus/usb/devices/$kennung/idVendor" ] && break
    sleep 0.1
    n=$((n + 1))
done

# ---------------------------------------------------------------------------
# Die Anmeldemaske gleich wieder zumachen.
#
# Beim Aufklappen kommt irgendeine Eingabe herein -- Deckelschalter, ein
# gestreiftes Touchpad, ein Tastendruck beim Aufwachen. xsecurelock startet
# auf jede Eingabe hin auth_x11, und dann steht sofort das Passwortfeld da,
# obwohl der Finger genuegt haette. Einen Schalter dagegen gibt es nicht:
# unter "strings /usr/bin/xsecurelock" findet sich keine Variable, mit der
# sich das Aufgehen unterdruecken liesse.
#
# Also dasselbe, was von Hand hilft: Escape. Geschickt wird es mit xdotool
# ueber XTEST -- das kommt auch an einem Tastaturgriff vorbei. Nur wenn
# wirklich gesperrt ist UND die Maske offensteht, sonst landete das Escape
# im Schreibtisch.
#
# Ueber gut zwei Sekunden hinweg, weil die Eingabe nicht auf einen Schlag
# kommt: der Hook laeuft direkt beim Aufwachen, die Maske geht manchmal erst
# einen Wimpernschlag spaeter auf.
#
# Anzeige und Cookie stehen schon oben fest.
if [ -n "$benutzer" ] && [ -n "$anzeige" ] && pgrep -x xsecurelock >/dev/null 2>&1; then
    # Im Hintergrund, und das ist wichtig: /usr/bin/zzz arbeitet die Hooks
    # der Reihe nach ab. Zwei Sekunden Warten hier wuerden 20-funk genauso
    # lange aufhalten -- und damit das WLAN nach dem Aufwachen.
    (
        n=0
        while [ "$n" -lt 12 ]; do
            if pgrep -x auth_x11 >/dev/null 2>&1; then
                su "$benutzer" -c \
                   "DISPLAY='$anzeige' XAUTHORITY='$cookie' xdotool key Escape" \
                   >/dev/null 2>&1
                notiere "Anmeldemaske mit Escape geschlossen"
            fi
            sleep 0.2
            n=$((n + 1))
        done
    ) >/dev/null 2>&1 &
fi

exit 0
