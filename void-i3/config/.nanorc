# nano ist der Editor fuers Terminal: EDITOR/VISUAL zeigen hierher, also
# landet git commit, crontab und visudo in nano. Fuer alles Groessere gibt
# es VS Code (Mod+c).

# Syntaxhervorhebung: die Definitionen liegen im nano-Paket, muessen aber
# ausdruecklich eingebunden werden.
include "/usr/share/nano/*.nanorc"

set linenumbers
set autoindent
set tabstospaces
set tabsize 4
set softwrap
set mouse
set trimblanks
# Zeigt die Tastenkombinationen dauerhaft unten an.
set titlecolor bold,white,blue
set numbercolor cyan
